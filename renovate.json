{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "docker:pinDigests",
    "helpers:pinGitHubActionDigests"
  ],
  "dockerfile": {
    "managerFilePatterns": [
      "/(^|/)Containerfile[^/]*$/"
    ]
  },
  "packageRules": [
    {
      "description": "go.mod's toolchain and the golang build image must move together (hack/check-pins.sh)",
      "matchPackageNames": [
        "go",
        "golang",
        "docker.io/library/golang"
      ],
      "groupName": "Go toolchain"
    },
    {
      "description": "Fedora base images follow the rolling release tag (B17): no digest pins; Renovate only proposes the next Fedora release",
      "matchPackageNames": [
        "/^quay\\.io/fedora//"
      ],
      "groupName": "Fedora base images",
      "pinDigests": false
    },
    {
      "description": "Built-in monitoring (P1-1): Prometheus and Alertmanager move together",
      "matchPackageNames": [
        "quay.io/prometheus/prometheus",
        "quay.io/prometheus/alertmanager"
      ],
      "groupName": "Built-in monitoring"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Third-party images embedded in the OS image (ARG X_IMAGE=repo:tag@digest, not used in FROM)",
      "managerFilePatterns": [
        "/(^|/)Containerfile[^/]*$/"
      ],
      "matchStrings": [
        "ARG [A-Z_]+_IMAGE=(?<depName>[^:@\\s]+):(?<currentValue>[^@\\s]+)@(?<currentDigest>sha256:[a-f0-9]{64})"
      ],
      "datasourceTemplate": "docker"
    }
  ]
}
