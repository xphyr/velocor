# Kubernetes CSI driver. Multi-arch: the Go build runs natively on the build platform and
# cross-compiles; only the small runtime stage runs under emulation. The runtime follows
# Fedora's rolling fedora-minimal 45 (resolved to a digest per build by `make`).
ARG FEDORA_MINIMAL_IMAGE=quay.io/fedora/fedora-minimal:46
FROM --platform=$BUILDPLATFORM docker.io/library/golang:1.27.4@sha256:205c7636d74e0ffbe3d007162df7d74f859f5a8c8322dfb9f907977686c126cf AS builder

ENV CGO_ENABLED=0 GOTOOLCHAIN=local
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download

COPY . .
ARG TARGETOS=linux
ARG TARGETARCH=amd64
ARG VERSION=unknown
ARG COMMIT=unknown
ARG BUILD_TIME=unknown
RUN GOOS=${TARGETOS} GOARCH=${TARGETARCH} \
    go build -trimpath -ldflags="-s -w -X github.com/velocor/velocor/internal/version.Version=${VERSION} -X github.com/velocor/velocor/internal/version.Commit=${COMMIT} -X github.com/velocor/velocor/internal/version.BuildTime=${BUILD_TIME}" \
    -o /out/velocor-csi ./cmd/velocor-csi

FROM ${FEDORA_MINIMAL_IMAGE}

RUN microdnf install -y nvme-cli iscsi-initiator-utils e2fsprogs xfsprogs util-linux && microdnf clean all
RUN mkdir -p /csi /var/lib/kubelet

COPY --from=builder /out/velocor-csi /usr/bin/velocor-csi

ENTRYPOINT ["/usr/bin/velocor-csi"]
