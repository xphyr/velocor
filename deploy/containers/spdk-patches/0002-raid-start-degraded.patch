--- a/test/unit/lib/bdev/raid/bdev_raid.c/bdev_raid_ut.c
+++ b/test/unit/lib/bdev/raid/bdev_raid.c/bdev_raid_ut.c
@@ -1360,6 +1360,107 @@
 }
 
 static void
+start_degraded_cb(void *ctx, int status)
+{
+	*(int *)ctx = status;
+}
+
+/* A superblock raid waiting for an absent member can be started without it. */
+static void
+test_raid_start_degraded(void)
+{
+	struct rpc_bdev_raid_create_ctx req;
+	struct rpc_bdev_raid_delete_ctx delete_req;
+	struct raid_bdev_superblock *sb;
+	struct raid_bdev *pbdev;
+	struct raid_base_bdev_info *base_info;
+	uint8_t last = g_max_base_drives - 1;
+	size_t sb_len;
+	int status = 1;
+	uint8_t i;
+
+	set_globals();
+	CU_ASSERT(raid_bdev_init() == 0);
+
+	/* The last member doesn't exist: the raid stays configuring. */
+	create_raid_bdev_create_req(&req, "raid1", 0, true, 0, true);
+	free(req.base_bdevs.items[last]);
+	req.base_bdevs.items[last] = strdup("Missing0n1");
+	SPDK_CU_ASSERT_FATAL(req.base_bdevs.items[last] != NULL);
+	rpc_bdev_raid_create(NULL, NULL);
+	CU_ASSERT(g_rpc_err == 0);
+	free_test_req(&req);
+
+	pbdev = raid_bdev_find_by_name("raid1");
+	SPDK_CU_ASSERT_FATAL(pbdev != NULL);
+	CU_ASSERT(pbdev->state == SPDK_BDEV_RAID_STATE_CONFIGURING);
+	CU_ASSERT(pbdev->num_base_bdevs_discovered == g_max_base_drives - 1);
+	CU_ASSERT(pbdev->num_base_bdevs_operational == g_max_base_drives);
+
+	/* Without a superblock there's nothing to record the missing member in. */
+	CU_ASSERT(raid_bdev_start_degraded(pbdev, start_degraded_cb, &status) == -EINVAL);
+
+	/* The superblock as loaded from the members: every slot configured. */
+	sb_len = sizeof(*sb) + g_max_base_drives * sizeof(sb->base_bdevs[0]);
+	sb = calloc(1, sb_len);
+	SPDK_CU_ASSERT_FATAL(sb != NULL);
+	sb->length = sb_len;
+	spdk_uuid_copy(&sb->uuid, &pbdev->bdev.uuid);
+	sb->block_size = g_block_len;
+	sb->raid_size = pbdev->base_bdev_info[0].data_size;
+	sb->seq_number = 1;
+	sb->base_bdevs_size = g_max_base_drives;
+	for (i = 0; i < g_max_base_drives; i++) {
+		sb->base_bdevs[i].slot = i;
+		sb->base_bdevs[i].state = RAID_SB_BASE_BDEV_CONFIGURED;
+		spdk_uuid_copy(&sb->base_bdevs[i].uuid, &pbdev->base_bdev_info[i].uuid);
+		sb->base_bdevs[i].data_offset = pbdev->base_bdev_info[0].data_offset;
+		sb->base_bdevs[i].data_size = pbdev->base_bdev_info[0].data_size;
+	}
+	pbdev->sb = sb;
+	/* As raid_bdev_create_from_sb() does: every slot's data area comes from the superblock. */
+	pbdev->base_bdev_info[last].data_offset = pbdev->base_bdev_info[0].data_offset;
+	pbdev->base_bdev_info[last].data_size = pbdev->base_bdev_info[0].data_size;
+
+	/* Not enough members for the raid level: refused, nothing changed. */
+	pbdev->min_base_bdevs_operational = g_max_base_drives;
+	CU_ASSERT(raid_bdev_start_degraded(pbdev, start_degraded_cb, &status) == -ENODEV);
+	CU_ASSERT(pbdev->state == SPDK_BDEV_RAID_STATE_CONFIGURING);
+	CU_ASSERT(sb->base_bdevs[last].state == RAID_SB_BASE_BDEV_CONFIGURED);
+	CU_ASSERT(pbdev->num_base_bdevs_operational == g_max_base_drives);
+	pbdev->min_base_bdevs_operational = 1;
+
+	/* Start degraded: online without the absent member, whose slot is now empty. */
+	CU_ASSERT(raid_bdev_start_degraded(pbdev, start_degraded_cb, &status) == 0);
+	poll_app_thread();
+	CU_ASSERT(status == 0);
+	CU_ASSERT(pbdev->state == SPDK_BDEV_RAID_STATE_ONLINE);
+	CU_ASSERT(pbdev->num_base_bdevs_operational == g_max_base_drives - 1);
+	CU_ASSERT(pbdev->num_base_bdevs_discovered == g_max_base_drives - 1);
+	CU_ASSERT(sb->base_bdevs[last].state == RAID_SB_BASE_BDEV_MISSING);
+	for (i = 0; i < last; i++) {
+		CU_ASSERT(sb->base_bdevs[i].state == RAID_SB_BASE_BDEV_CONFIGURED);
+	}
+	base_info = &pbdev->base_bdev_info[last];
+	CU_ASSERT(base_info->name == NULL);
+	CU_ASSERT(spdk_uuid_is_null(&base_info->uuid));
+	CU_ASSERT(!base_info->is_configured);
+
+	/* Already online: refused. */
+	CU_ASSERT(raid_bdev_start_degraded(pbdev, start_degraded_cb, &status) == -EINVAL);
+
+	create_raid_bdev_delete_req(&delete_req, "raid1", 0);
+	rpc_bdev_raid_delete(NULL, NULL);
+	CU_ASSERT(g_rpc_err == 0);
+	verify_raid_bdev_present("raid1", false);
+	free(sb);
+
+	raid_bdev_exit();
+	base_bdevs_cleanup();
+	reset_globals();
+}
+
