@@ -346,6 +346,61 @@
 SPDK_RPC_REGISTER("bdev_raid_remove_base_bdev", rpc_bdev_raid_remove_base_bdev, SPDK_RPC_RUNTIME)
 
 static void
+rpc_bdev_raid_start_degraded_done(void *ctx, int status)
+{
+	struct spdk_jsonrpc_request *request = ctx;
+
+	if (status != 0) {
+		spdk_jsonrpc_send_error_response_fmt(request, status,
+						     "Failed to start RAID bdev degraded: %s",
+						     spdk_strerror(-status));
+		return;
+	}
+
+	spdk_jsonrpc_send_bool_response(request, true);
+}
+
+/*
+ * brief:
+ * bdev_raid_start_degraded starts a raid bdev with a superblock that is waiting for absent
+ * base bdevs, without them. It takes the raid bdev name as input.
+ */
+static void
+rpc_bdev_raid_start_degraded(struct spdk_jsonrpc_request *request,
+			     const struct spdk_json_val *params)
+{
+	struct rpc_bdev_raid_start_degraded_ctx req = {};
+	struct raid_bdev *raid_bdev;
+	int rc;
+
+	if (spdk_json_decode_object(params, rpc_bdev_raid_start_degraded_decoders,
+				    SPDK_COUNTOF(rpc_bdev_raid_start_degraded_decoders),
+				    &req)) {
+		spdk_jsonrpc_send_error_response(request, SPDK_JSONRPC_ERROR_PARSE_ERROR,
+						 "spdk_json_decode_object failed");
+		goto cleanup;
+	}
+
+	raid_bdev = raid_bdev_find_by_name(req.name);
+	if (raid_bdev == NULL) {
+		spdk_jsonrpc_send_error_response_fmt(request, -ENODEV, "raid bdev %s is not found in config",
+						     req.name);
+		goto cleanup;
+	}
+
+	rc = raid_bdev_start_degraded(raid_bdev, rpc_bdev_raid_start_degraded_done, request);
+	if (rc != 0) {
+		spdk_jsonrpc_send_error_response_fmt(request, rc,
+						     "Failed to start RAID bdev %s degraded: %s",
+						     req.name, spdk_strerror(-rc));
+	}
+
+cleanup:
+	free_rpc_bdev_raid_start_degraded(&req);
+}
+SPDK_RPC_REGISTER("bdev_raid_start_degraded", rpc_bdev_raid_start_degraded, SPDK_RPC_RUNTIME)
+
