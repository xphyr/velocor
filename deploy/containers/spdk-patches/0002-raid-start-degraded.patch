From: Velocor <noreply@velocor.invalid>
Subject: [PATCH] bdev/raid: add bdev_raid_start_degraded

A raid bdev with a superblock waits in the configuring state until every member that its
superblock records as configured appears. A member that fails while the application is
not running (a dead disk found at boot) therefore makes the whole array unavailable, even
when the remaining members could serve it; there is no way to start it degraded.

Add raid_bdev_start_degraded() and the bdev_raid_start_degraded RPC. For a configuring
raid with a superblock whose present members meet the level's minimum, the absent members
are marked MISSING in the superblock and their slots emptied (so bdev_raid_add_base_bdev
can fill them and rebuild), and the raid is configured through the normal path, which
writes the superblock with a new sequence number to the present members. A missing member
that returns later carries an older sequence number and is not taken back by examine.
This is the equivalent of Linux md's `mdadm --run` and is meant to be an explicit operator
decision, never automatic: a member that is merely slow to appear would otherwise be
dropped.

Unit test: test_raid_start_degraded.

Applies to SPDK v26.09 (0bbb7fe4dccfb31e8d446da8822360704949d1e9).
---
--- a/module/bdev/raid/bdev_raid.c
+++ b/module/bdev/raid/bdev_raid.c
@@ -3680,6 +3680,91 @@
 	return rc;
 }
 
+/*
+ * Start a raid bdev with a superblock that is still configuring because members recorded as
+ * configured in its superblock are absent (e.g. a disk failed while the application was not
+ * running). The absent members are marked missing and their slots emptied, so they can be
+ * replaced with bdev_raid_add_base_bdev later; configuring the raid then writes the superblock,
+ * with a new sequence number, to the present members, so a missing member that returns later
+ * is not taken back. Requires at least the minimum number of members for the raid level.
+ */
+int
+raid_bdev_start_degraded(struct raid_bdev *raid_bdev, raid_bdev_action_cb cb_fn, void *cb_ctx)
+{
+	struct raid_bdev_superblock *sb = raid_bdev->sb;
+	struct raid_bdev_sb_base_bdev *sb_base_bdev;
+	struct raid_base_bdev_info *base_info;
+	uint8_t i, num_missing = 0;
+
+	assert(spdk_get_thread() == spdk_thread_get_app_thread());
+
+	if (raid_bdev->state != SPDK_BDEV_RAID_STATE_CONFIGURING) {
+		SPDK_ERRLOG("raid bdev '%s' is not configuring\n", raid_bdev->bdev.name);
+		return -EINVAL;
+	}
+
+	if (!raid_bdev->superblock_enabled || sb == NULL) {
+		SPDK_ERRLOG("raid bdev '%s' has no superblock\n", raid_bdev->bdev.name);
+		return -EINVAL;
+	}
+
+	RAID_FOR_EACH_BASE_BDEV(raid_bdev, base_info) {
+		if (base_info->desc != NULL && !base_info->is_configured) {
+			SPDK_ERRLOG("raid bdev '%s': a base bdev is being configured\n", raid_bdev->bdev.name);
+			return -EBUSY;
+		}
+	}
+
+	for (i = 0; i < sb->base_bdevs_size; i++) {
+		sb_base_bdev = &sb->base_bdevs[i];
+		if (sb_base_bdev->state == RAID_SB_BASE_BDEV_CONFIGURED &&
+		    sb_base_bdev->slot < raid_bdev->num_base_bdevs &&
+		    !raid_bdev->base_bdev_info[sb_base_bdev->slot].is_configured) {
+			num_missing++;
+		}
+	}
+
+	if (num_missing == 0) {
+		SPDK_ERRLOG("raid bdev '%s' is not missing any base bdev\n", raid_bdev->bdev.name);
+		return -EALREADY;
+	}
+
+	if (raid_bdev->num_base_bdevs_operational - num_missing != raid_bdev->num_base_bdevs_discovered) {
+		SPDK_ERRLOG("raid bdev '%s': superblock and discovered base bdevs disagree\n",
+			    raid_bdev->bdev.name);
+		return -EINVAL;
+	}
+
+	if (raid_bdev->num_base_bdevs_discovered < raid_bdev->min_base_bdevs_operational) {
+		SPDK_ERRLOG("raid bdev '%s' needs at least %u base bdevs, %u present\n",
+			    raid_bdev->bdev.name, raid_bdev->min_base_bdevs_operational,
+			    raid_bdev->num_base_bdevs_discovered);
+		return -ENODEV;
+	}
+
+	for (i = 0; i < sb->base_bdevs_size; i++) {
+		sb_base_bdev = &sb->base_bdevs[i];
+		if (sb_base_bdev->state != RAID_SB_BASE_BDEV_CONFIGURED ||
+		    sb_base_bdev->slot >= raid_bdev->num_base_bdevs) {
+			continue;
+		}
+		base_info = &raid_bdev->base_bdev_info[sb_base_bdev->slot];
+		if (base_info->is_configured) {
+			continue;
+		}
+
+		SPDK_NOTICELOG("Starting raid bdev '%s' without base bdev in slot %u\n",
+			       raid_bdev->bdev.name, sb_base_bdev->slot);
+		sb_base_bdev->state = RAID_SB_BASE_BDEV_MISSING;
+		free(base_info->name);
+		base_info->name = NULL;
+		spdk_uuid_set_null(&base_info->uuid);
+		raid_bdev->num_base_bdevs_operational--;
+	}
+
+	return raid_bdev_configure(raid_bdev, cb_fn, cb_ctx);
+}
+
 static int
 raid_bdev_create_from_sb(const struct raid_bdev_superblock *sb, struct raid_bdev **raid_bdev_out)
 {
