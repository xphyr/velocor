diff --git a/module/bdev/lvol/vbdev_lvol.c b/module/bdev/lvol/vbdev_lvol.c
index 5f3fa87..5c6ddae 100644
--- a/module/bdev/lvol/vbdev_lvol.c
+++ b/module/bdev/lvol/vbdev_lvol.c
@@ -2426,4 +2426,65 @@ vbdev_lvol_set_external_parent(struct spdk_lvol *lvol, const char *esnap_name,
 	spdk_bdev_close(desc);
 }
 
+int
+vbdev_lvol_get_fragmap(struct spdk_lvol *lvol, uint64_t offset, uint64_t size,
+		       struct vbdev_lvol_fragmap *fragmap)
+{
+	struct spdk_blob *blob = lvol->blob;
+	uint64_t cluster_size = spdk_bs_get_cluster_size(lvol->lvol_store->blobstore);
+	uint64_t io_unit_size = spdk_bs_get_io_unit_size(lvol->lvol_store->blobstore);
+	uint64_t lvol_size = spdk_blob_get_num_clusters(blob) * cluster_size;
+	uint64_t io_unit, end_io_unit, data, hole, first, last, i;
+
+	memset(fragmap, 0, sizeof(*fragmap));
+	if (cluster_size == 0 || io_unit_size == 0 || offset > lvol_size) {
+		return -EINVAL;
+	}
+	if (size == 0) {
+		size = lvol_size - offset;
+	}
+	if (offset % cluster_size != 0 || size % cluster_size != 0 || size > lvol_size - offset) {
+		SPDK_ERRLOG("lvol %s: fragmap range %" PRIu64 "+%" PRIu64 " isn't a range of whole "
+			    "%" PRIu64 "-byte clusters within its %" PRIu64 " bytes\n", lvol->unique_id,
+			    offset, size, cluster_size, lvol_size);
+		return -EINVAL;
+	}
+
+	fragmap->cluster_size = cluster_size;
+	fragmap->num_clusters = size / cluster_size;
+	fragmap->map = calloc(spdk_max(spdk_divide_round_up(fragmap->num_clusters, 8), 1), 1);
+	if (fragmap->map == NULL) {
+		return -ENOMEM;
+	}
+
+	/* Allocation is per cluster, so the boundaries found are cluster-aligned. */
+	io_unit = offset / io_unit_size;
+	end_io_unit = (offset + size) / io_unit_size;
+	while (io_unit < end_io_unit) {
+		data = spdk_blob_get_next_allocated_io_unit(blob, io_unit);
+		if (data == UINT64_MAX || data >= end_io_unit) {
+			break;
+		}
+		hole = spdk_blob_get_next_unallocated_io_unit(blob, data);
+		if (hole == UINT64_MAX || hole > end_io_unit) {
+			hole = end_io_unit;
+		}
+		first = (data * io_unit_size - offset) / cluster_size;
+		last = spdk_divide_round_up(hole * io_unit_size - offset, cluster_size);
+		for (i = first; i < last; i++) {
+			fragmap->map[i / 8] |= 1 << (i % 8);
+		}
+		fragmap->num_allocated_clusters += last - first;
+		io_unit = hole;
+	}
+	return 0;
+}
+
+void
+vbdev_lvol_fragmap_free(struct vbdev_lvol_fragmap *fragmap)
+{
+	free(fragmap->map);
+	fragmap->map = NULL;
+}
+
 SPDK_LOG_REGISTER_COMPONENT(vbdev_lvol)
diff --git a/module/bdev/lvol/vbdev_lvol.h b/module/bdev/lvol/vbdev_lvol.h
index 945f0fe..eefd207 100644
--- a/module/bdev/lvol/vbdev_lvol.h
+++ b/module/bdev/lvol/vbdev_lvol.h
@@ -184,4 +184,32 @@ int vbdev_lvol_shallow_copy(struct spdk_lvol *lvol, const char *bdev_name,
 void vbdev_lvol_set_external_parent(struct spdk_lvol *lvol, const char *esnap_name,
 				    spdk_lvol_op_complete cb_fn, void *cb_arg);
 
+/* Clusters of a range of an lvol that the lvol's own blob has allocated (bdev_lvol_get_fragmap). */
+struct vbdev_lvol_fragmap {
+	uint64_t	cluster_size;
+	uint64_t	num_clusters;
+	uint64_t	num_allocated_clusters;
+	/* One bit per cluster of the range, cluster i at bit (i % 8) of byte i / 8; 1 = allocated. */
+	uint8_t		*map;
+};
+
+/**
+ * Report which clusters of [offset, offset + size) of an lvol the lvol has allocated itself.
+ * Clusters it only reads through from its parent (a snapshot, a clone's origin, an external
+ * snapshot) are not allocated. So for a snapshot this is what was written while it was the
+ * newest layer, and the changes between two snapshots of a chain are the union of the maps of
+ * the layers after the older one, up to the newer one. The map is read from the blob's cluster
+ * table, on the thread that changes it; it does no I/O.
+ *
+ * \param lvol The lvol.
+ * \param offset Start of the range in bytes, a multiple of the cluster size.
+ * \param size Length in bytes, a multiple of the cluster size; 0 means to the end of the lvol.
+ * \param fragmap Filled in on success; release with vbdev_lvol_fragmap_free().
+ * \return 0 on success, -EINVAL for a range that isn't cluster-aligned or exceeds the lvol,
+ * -ENOMEM.
+ */
+int vbdev_lvol_get_fragmap(struct spdk_lvol *lvol, uint64_t offset, uint64_t size,
+			   struct vbdev_lvol_fragmap *fragmap);
+void vbdev_lvol_fragmap_free(struct vbdev_lvol_fragmap *fragmap);
+
 #endif /* SPDK_VBDEV_LVOL_H */
diff --git a/module/bdev/lvol/vbdev_lvol_rpc.c b/module/bdev/lvol/vbdev_lvol_rpc.c
index fb1bf05..341023d 100644
--- a/module/bdev/lvol/vbdev_lvol_rpc.c
+++ b/module/bdev/lvol/vbdev_lvol_rpc.c
@@ -9,6 +9,7 @@
 #include "spdk/util.h"
 #include "vbdev_lvol.h"
 #include "spdk/string.h"
+#include "spdk/base64.h"
 #include "spdk/log.h"
 #include "spdk_internal/rpc_autogen.h"
 
@@ -428,6 +429,66 @@ rpc_bdev_lvol_snapshot_group(struct spdk_jsonrpc_request *request,
 
 SPDK_RPC_REGISTER("bdev_lvol_snapshot_group", rpc_bdev_lvol_snapshot_group, SPDK_RPC_RUNTIME)
 
+/*
+ * bdev_lvol_get_fragmap: which clusters of a range of an lvol it has allocated itself, as a
+ * base64 bitmap (the RPC of Longhorn's SPDK fork, same parameters and result).
+ */
+static void
+rpc_bdev_lvol_get_fragmap(struct spdk_jsonrpc_request *request, const struct spdk_json_val *params)
+{
+	struct rpc_bdev_lvol_get_fragmap_ctx req = {};
+	struct vbdev_lvol_fragmap fragmap;
+	struct spdk_json_write_ctx *w;
+	struct spdk_bdev *bdev;
+	struct spdk_lvol *lvol;
+	size_t map_len;
+	char *encoded = NULL;
+	int rc;
+
+	if (spdk_json_decode_object(params, rpc_bdev_lvol_get_fragmap_decoders,
+				    SPDK_COUNTOF(rpc_bdev_lvol_get_fragmap_decoders), &req)) {
+		spdk_jsonrpc_send_error_response(request, SPDK_JSONRPC_ERROR_INVALID_PARAMS,
+						 "spdk_json_decode_object failed");
+		goto cleanup;
+	}
+
+	bdev = spdk_bdev_get_by_name(req.name);
+	lvol = bdev ? vbdev_lvol_get_from_bdev(bdev) : NULL;
+	if (lvol == NULL) {
+		spdk_jsonrpc_send_error_response_fmt(request, -ENODEV, "lvol %s does not exist", req.name);
+		goto cleanup;
+	}
+
+	rc = vbdev_lvol_get_fragmap(lvol, req.offset, req.size, &fragmap);
+	if (rc != 0) {
+		spdk_jsonrpc_send_error_response(request, rc, spdk_strerror(-rc));
+		goto cleanup;
+	}
+	map_len = spdk_divide_round_up(fragmap.num_clusters, 8);
+	encoded = calloc(spdk_base64_get_encoded_strlen(map_len) + 1, 1);
+	if (encoded == NULL || spdk_base64_encode(encoded, fragmap.map, map_len) != 0) {
+		vbdev_lvol_fragmap_free(&fragmap);
+		spdk_jsonrpc_send_error_response(request, -ENOMEM, spdk_strerror(ENOMEM));
+		goto cleanup;
+	}
+
+	w = spdk_jsonrpc_begin_result(request);
+	spdk_json_write_object_begin(w);
+	spdk_json_write_named_uint64(w, "cluster_size", fragmap.cluster_size);
+	spdk_json_write_named_uint64(w, "num_clusters", fragmap.num_clusters);
+	spdk_json_write_named_uint64(w, "num_allocated_clusters", fragmap.num_allocated_clusters);
+	spdk_json_write_named_string(w, "fragmap", encoded);
+	spdk_json_write_object_end(w);
+	spdk_jsonrpc_end_result(request, w);
+	vbdev_lvol_fragmap_free(&fragmap);
+
+cleanup:
+	free(encoded);
+	free_rpc_bdev_lvol_get_fragmap(&req);
+}
+
+SPDK_RPC_REGISTER("bdev_lvol_get_fragmap", rpc_bdev_lvol_get_fragmap, SPDK_RPC_RUNTIME)
+
 static void
 rpc_bdev_lvol_clone_cb(void *cb_arg, struct spdk_lvol *lvol, int lvolerrno)
 {
