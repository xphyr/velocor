diff --git a/test/unit/lib/bdev/vbdev_lvol.c/vbdev_lvol_ut.c b/test/unit/lib/bdev/vbdev_lvol.c/vbdev_lvol_ut.c
index d830ad8..071c0e7 100644
--- a/test/unit/lib/bdev/vbdev_lvol.c/vbdev_lvol_ut.c
+++ b/test/unit/lib/bdev/vbdev_lvol.c/vbdev_lvol_ut.c
@@ -279,9 +279,32 @@ spdk_blob_get_num_clusters(struct spdk_blob *b)
  */
 uint64_t g_blob_allocated_io_unit_offset = 20;
 
+/*
+ * Fragmap tests set g_ut_alloc to one flag per cluster (g_num_clusters of them, with
+ * g_cluster_size / SPDK_BS_PAGE_SIZE io_units each) instead.
+ */
+static const bool *g_ut_alloc;
+
+static uint64_t
+ut_find_io_unit(uint64_t offset, bool allocated)
+{
+	uint64_t per_cluster = g_cluster_size / SPDK_BS_PAGE_SIZE;
+
+	while (offset < g_num_clusters * per_cluster) {
+		if (g_ut_alloc[offset / per_cluster] == allocated) {
+			return offset;
+		}
+		offset = (offset / per_cluster + 1) * per_cluster;
+	}
+	return UINT64_MAX;
+}
+
 uint64_t
 spdk_blob_get_next_allocated_io_unit(struct spdk_blob *blob, uint64_t offset)
 {
+	if (g_ut_alloc != NULL) {
+		return ut_find_io_unit(offset, true);
+	}
 	if (offset <= g_blob_allocated_io_unit_offset) {
 		return g_blob_allocated_io_unit_offset;
 	} else {
@@ -292,6 +315,9 @@ spdk_blob_get_next_allocated_io_unit(struct spdk_blob *blob, uint64_t offset)
 uint64_t
 spdk_blob_get_next_unallocated_io_unit(struct spdk_blob *blob, uint64_t offset)
 {
+	if (g_ut_alloc != NULL) {
+		return ut_find_io_unit(offset, false);
+	}
 	if (offset < g_blob_allocated_io_unit_offset) {
 		return offset;
 	} else {
@@ -2369,6 +2395,67 @@ ut_lvol_snapshot_group(void)
 	CU_ASSERT(g_lvol_store == NULL);
 }
 
+static void
+ut_lvol_get_fragmap(void)
+{
+	/* 12 clusters of 4 io_units: allocated 0, 3-5, 11. */
+	static const bool alloc[12] = { true, false, false, true, true, true, false, false, false, false, false, true };
+	struct spdk_lvol_store lvs = {};
+	struct spdk_lvol lvol = {};
+	struct vbdev_lvol_fragmap fm;
+	int saved_cluster_size = g_cluster_size, saved_num_clusters = g_num_clusters;
+	uint64_t cs;
+
+	g_cluster_size = 4 * SPDK_BS_PAGE_SIZE;
+	g_num_clusters = 12;
+	g_ut_alloc = alloc;
+	cs = g_cluster_size;
+	lvol.lvol_store = &lvs;
+	snprintf(lvol.unique_id, sizeof(lvol.unique_id), "fragmap");
+
+	/* The whole lvol: bits 0, 3, 4, 5 and 11. */
+	CU_ASSERT(vbdev_lvol_get_fragmap(&lvol, 0, 0, &fm) == 0);
+	CU_ASSERT(fm.cluster_size == cs);
+	CU_ASSERT(fm.num_clusters == 12);
+	CU_ASSERT(fm.num_allocated_clusters == 5);
+	CU_ASSERT(fm.map[0] == 0x39);	/* 0b00111001 */
+	CU_ASSERT(fm.map[1] == 0x08);	/* cluster 11 */
+	vbdev_lvol_fragmap_free(&fm);
+
+	/* A range starting inside an allocated run, and one ending inside it. */
+	CU_ASSERT(vbdev_lvol_get_fragmap(&lvol, 4 * cs, 4 * cs, &fm) == 0);	/* clusters 4-7 */
+	CU_ASSERT(fm.num_clusters == 4);
+	CU_ASSERT(fm.num_allocated_clusters == 2);
+	CU_ASSERT(fm.map[0] == 0x03);
+	vbdev_lvol_fragmap_free(&fm);
+	CU_ASSERT(vbdev_lvol_get_fragmap(&lvol, 2 * cs, 2 * cs, &fm) == 0);	/* clusters 2-3 */
+	CU_ASSERT(fm.num_allocated_clusters == 1);
+	CU_ASSERT(fm.map[0] == 0x02);
+	vbdev_lvol_fragmap_free(&fm);
+
+	/* Size 0 means to the end; a range of unallocated clusters is all zeros. */
+	CU_ASSERT(vbdev_lvol_get_fragmap(&lvol, 10 * cs, 0, &fm) == 0);
+	CU_ASSERT(fm.num_clusters == 2);
+	CU_ASSERT(fm.num_allocated_clusters == 1);
+	CU_ASSERT(fm.map[0] == 0x02);
+	vbdev_lvol_fragmap_free(&fm);
+	CU_ASSERT(vbdev_lvol_get_fragmap(&lvol, 6 * cs, 5 * cs, &fm) == 0);
+	CU_ASSERT(fm.num_allocated_clusters == 0);
+	CU_ASSERT(fm.map[0] == 0);
+	vbdev_lvol_fragmap_free(&fm);
+
+	/* Ranges that aren't whole clusters within the lvol are refused. */
+	CU_ASSERT(vbdev_lvol_get_fragmap(&lvol, SPDK_BS_PAGE_SIZE, cs, &fm) == -EINVAL);
+	CU_ASSERT(vbdev_lvol_get_fragmap(&lvol, 0, cs + SPDK_BS_PAGE_SIZE, &fm) == -EINVAL);
+	CU_ASSERT(vbdev_lvol_get_fragmap(&lvol, 8 * cs, 5 * cs, &fm) == -EINVAL);
+	CU_ASSERT(vbdev_lvol_get_fragmap(&lvol, 13 * cs, 0, &fm) == -EINVAL);
+	CU_ASSERT(fm.map == NULL);
+
+	g_ut_alloc = NULL;
+	g_cluster_size = saved_cluster_size;
+	g_num_clusters = saved_num_clusters;
+}
+
