diff --git a/module/bdev/lvol/vbdev_lvol.c b/module/bdev/lvol/vbdev_lvol.c
index 470b062..5f3fa87 100644
--- a/module/bdev/lvol/vbdev_lvol.c
+++ b/module/bdev/lvol/vbdev_lvol.c
@@ -1317,6 +1317,318 @@ ignore_bdev_event_cb(enum spdk_bdev_event_type type, struct spdk_bdev *bdev, voi
 {
 }
 
+/*
+ * Group snapshots: quiesce every member bdev, snapshot each while all are quiesced, unquiesce.
+ * Everything runs on the calling (app) thread; the quiesce and unquiesce completions come back
+ * on it.
+ */
+enum snapshot_group_member_state {
+	SNAPSHOT_GROUP_MEMBER_IDLE,		/* not quiesced (yet, or the quiesce failed) */
+	SNAPSHOT_GROUP_MEMBER_QUIESCING,
+	SNAPSHOT_GROUP_MEMBER_QUIESCED,
+	SNAPSHOT_GROUP_MEMBER_UNQUIESCING,
+	SNAPSHOT_GROUP_MEMBER_DONE,		/* unquiesced */
+};
+
+enum snapshot_group_phase {
+	SNAPSHOT_GROUP_QUIESCE,
+	SNAPSHOT_GROUP_SNAPSHOT,
+	SNAPSHOT_GROUP_UNQUIESCE,
+};
+
+struct snapshot_group_ctx;
+
+struct snapshot_group_member {
+	struct snapshot_group_ctx		*group;
+	struct spdk_lvol			*lvol;
+	/* Held for the whole operation, so the bdev can't be freed under a pending (un)quiesce. */
+	struct spdk_bdev_desc			*desc;
+	const char				*snapshot_name;
+	enum snapshot_group_member_state	state;
+};
+
+struct snapshot_group_ctx {
+	struct snapshot_group_member	*members;
+	struct spdk_lvol		**snapshots;
+	size_t				num;
+	size_t				next_snapshot;
+	/* Quiesce or unquiesce completions still to come. */
+	size_t				outstanding;
+	enum snapshot_group_phase	phase;
+	/* Set while quiesces are being submitted, so completions can't finish the group early. */
+	bool				submitting;
+	int				status;
+	struct spdk_poller		*timer;
+	vbdev_lvol_snapshot_group_cb	cb_fn;
+	void				*cb_arg;
+};
+
+static void snapshot_group_advance(struct snapshot_group_ctx *ctx);
+
+static void
+snapshot_group_free(struct snapshot_group_ctx *ctx)
+{
+	size_t i;
+
+	for (i = 0; i < ctx->num; i++) {
+		if (ctx->members[i].desc != NULL) {
+			spdk_bdev_close(ctx->members[i].desc);
+		}
+	}
+	free(ctx->members);
+	free(ctx->snapshots);
+	free(ctx);
+}
+
+static void
+snapshot_group_finish(struct snapshot_group_ctx *ctx)
+{
+	spdk_poller_unregister(&ctx->timer);
+	ctx->cb_fn(ctx->cb_arg, ctx->snapshots, ctx->status);
+	snapshot_group_free(ctx);
+}
+
+static void
+snapshot_group_unquiesced(void *cb_arg, int status)
+{
+	struct snapshot_group_member *member = cb_arg;
+	struct snapshot_group_ctx *ctx = member->group;
+
+	assert(ctx->outstanding > 0);
+	ctx->outstanding--;
+	member->state = SNAPSHOT_GROUP_MEMBER_DONE;
+	if (status != 0) {
+		SPDK_ERRLOG("group snapshot: unquiescing lvol %s failed: %s\n",
+			    member->lvol->unique_id, spdk_strerror(-status));
+		if (ctx->status == 0) {
+			ctx->status = status;
+		}
+	}
+	snapshot_group_advance(ctx);
+}
+
+static void
+snapshot_group_unquiesce_member(struct snapshot_group_member *member)
+{
+	struct snapshot_group_ctx *ctx = member->group;
+	int rc;
+
+	assert(member->state == SNAPSHOT_GROUP_MEMBER_QUIESCED);
+	member->state = SNAPSHOT_GROUP_MEMBER_UNQUIESCING;
+	ctx->outstanding++;
+	rc = spdk_bdev_unquiesce(member->lvol->bdev, &g_lvol_if, snapshot_group_unquiesced, member);
+	if (rc != 0) {
+		/* Not expected: the range was quiesced by us. Log loudly; I/O to it stays queued. */
+		SPDK_ERRLOG("group snapshot: can't unquiesce lvol %s: %s\n",
+			    member->lvol->unique_id, spdk_strerror(-rc));
+		ctx->outstanding--;
+		member->state = SNAPSHOT_GROUP_MEMBER_DONE;
+		if (ctx->status == 0) {
+			ctx->status = rc;
+		}
+	}
+}
+
+/* Stop: no (more) snapshots; unquiesce what is quiesced now and what completes later. */
+static void
+snapshot_group_abort(struct snapshot_group_ctx *ctx, int status)
+{
+	size_t i;
+
+	if (ctx->status == 0) {
+		ctx->status = status;
+	}
+	if (ctx->phase == SNAPSHOT_GROUP_UNQUIESCE) {
+		return;
+	}
+	ctx->phase = SNAPSHOT_GROUP_UNQUIESCE;
+	spdk_poller_unregister(&ctx->timer);
+	for (i = 0; i < ctx->num; i++) {
+		if (ctx->members[i].state == SNAPSHOT_GROUP_MEMBER_QUIESCED) {
+			snapshot_group_unquiesce_member(&ctx->members[i]);
+		}
+	}
+}
+
+static void
+snapshot_group_quiesced(void *cb_arg, int status)
+{
+	struct snapshot_group_member *member = cb_arg;
+	struct snapshot_group_ctx *ctx = member->group;
+
+	assert(ctx->outstanding > 0);
+	ctx->outstanding--;
+	if (status != 0) {
+		SPDK_ERRLOG("group snapshot: quiescing lvol %s failed: %s\n",
+			    member->lvol->unique_id, spdk_strerror(-status));
+		member->state = SNAPSHOT_GROUP_MEMBER_IDLE;
+		snapshot_group_abort(ctx, status);
+	} else {
+		member->state = SNAPSHOT_GROUP_MEMBER_QUIESCED;
+		if (ctx->phase == SNAPSHOT_GROUP_UNQUIESCE) {
+			/* Completed after a timeout or another member's failure. */
+			snapshot_group_unquiesce_member(member);
+		}
+	}
+	snapshot_group_advance(ctx);
+}
+
+static int
+snapshot_group_timeout(void *arg)
+{
+	struct snapshot_group_ctx *ctx = arg;
+
+	spdk_poller_unregister(&ctx->timer);
+	if (ctx->phase == SNAPSHOT_GROUP_QUIESCE) {
+		SPDK_ERRLOG("group snapshot: I/O to the lvols did not drain in time; no snapshots taken\n");
+		snapshot_group_abort(ctx, -ETIMEDOUT);
+		snapshot_group_advance(ctx);
+	}
+	return SPDK_POLLER_BUSY;
+}
+
+static void
+snapshot_group_snapshot_done(void *cb_arg, struct spdk_lvol *snapshot, int lvolerrno)
+{
+	struct snapshot_group_ctx *ctx = cb_arg;
+	struct snapshot_group_member *member = &ctx->members[ctx->next_snapshot];
+
+	if (lvolerrno != 0) {
+		SPDK_ERRLOG("group snapshot: snapshot %s of lvol %s failed: %s\n",
+			    member->snapshot_name, member->lvol->unique_id, spdk_strerror(-lvolerrno));
+		snapshot_group_abort(ctx, lvolerrno);
+	} else {
+		ctx->snapshots[ctx->next_snapshot] = snapshot;
+	}
+	ctx->next_snapshot++;
+	snapshot_group_advance(ctx);
+}
+
+static void
+snapshot_group_advance(struct snapshot_group_ctx *ctx)
+{
+	size_t i;
+
+	if (ctx->submitting || ctx->outstanding > 0) {
+		return;
+	}
+	switch (ctx->phase) {
+	case SNAPSHOT_GROUP_QUIESCE:
+		/* Every member is quiesced: no I/O is in flight to any of them. */
+		spdk_poller_unregister(&ctx->timer);
+		ctx->phase = SNAPSHOT_GROUP_SNAPSHOT;
+	/* fallthrough */
+	case SNAPSHOT_GROUP_SNAPSHOT:
+		if (ctx->next_snapshot < ctx->num) {
+			struct snapshot_group_member *member = &ctx->members[ctx->next_snapshot];
+
+			vbdev_lvol_create_snapshot(member->lvol, member->snapshot_name,
+						   snapshot_group_snapshot_done, ctx);
+			return;
+		}
+		ctx->phase = SNAPSHOT_GROUP_UNQUIESCE;
+		for (i = 0; i < ctx->num; i++) {
+			snapshot_group_unquiesce_member(&ctx->members[i]);
+		}
+		if (ctx->outstanding > 0) {
+			return;
+		}
+		break;
+	case SNAPSHOT_GROUP_UNQUIESCE:
+		break;
+	}
+	snapshot_group_finish(ctx);
+}
+
+void
+vbdev_lvol_create_snapshot_group(struct spdk_lvol **lvols, const char **snapshot_names,
+				 size_t num, uint32_t quiesce_timeout_ms,
+				 vbdev_lvol_snapshot_group_cb cb_fn, void *cb_arg)
+{
+	struct snapshot_group_ctx *ctx;
+	size_t i, j;
+	int rc;
+
+	if (num == 0 || num > VBDEV_LVOL_SNAPSHOT_GROUP_MAX) {
+		cb_fn(cb_arg, NULL, -EINVAL);
+		return;
+	}
+	for (i = 0; i < num; i++) {
+		if (lvols[i] == NULL || lvols[i]->bdev == NULL || snapshot_names[i] == NULL) {
+			cb_fn(cb_arg, NULL, -EINVAL);
+			return;
+		}
+		/* Quiescing a bdev twice would wait for itself. */
+		for (j = 0; j < i; j++) {
+			if (lvols[j] == lvols[i]) {
+				SPDK_ERRLOG("group snapshot: lvol %s is listed twice\n", lvols[i]->unique_id);
+				cb_fn(cb_arg, NULL, -EINVAL);
+				return;
+			}
+		}
+	}
+
+	ctx = calloc(1, sizeof(*ctx));
+	if (ctx == NULL) {
+		cb_fn(cb_arg, NULL, -ENOMEM);
+		return;
+	}
+	ctx->members = calloc(num, sizeof(*ctx->members));
+	ctx->snapshots = calloc(num, sizeof(*ctx->snapshots));
+	if (ctx->members == NULL || ctx->snapshots == NULL) {
+		free(ctx->members);
+		free(ctx->snapshots);
+		free(ctx);
+		cb_fn(cb_arg, NULL, -ENOMEM);
+		return;
+	}
+	ctx->num = num;
+	ctx->cb_fn = cb_fn;
+	ctx->cb_arg = cb_arg;
+	ctx->phase = SNAPSHOT_GROUP_QUIESCE;
+
+	for (i = 0; i < num; i++) {
+		struct snapshot_group_member *member = &ctx->members[i];
+
+		member->group = ctx;
+		member->lvol = lvols[i];
+		member->snapshot_name = snapshot_names[i];
+		rc = spdk_bdev_open_ext(spdk_bdev_get_name(lvols[i]->bdev), false, ignore_bdev_event_cb,
+					NULL, &member->desc);
+		if (rc != 0) {
+			SPDK_ERRLOG("group snapshot: can't open lvol %s: %s\n", lvols[i]->unique_id,
+				    spdk_strerror(-rc));
+			member->desc = NULL;
+			cb_fn(cb_arg, NULL, rc);
+			snapshot_group_free(ctx);
+			return;
+		}
+	}
+
+	if (quiesce_timeout_ms > 0) {
+		ctx->timer = SPDK_POLLER_REGISTER(snapshot_group_timeout, ctx,
+						  (uint64_t)quiesce_timeout_ms * 1000);
+	}
+
+	ctx->submitting = true;
+	for (i = 0; i < num && ctx->phase == SNAPSHOT_GROUP_QUIESCE; i++) {
+		struct snapshot_group_member *member = &ctx->members[i];
+
+		member->state = SNAPSHOT_GROUP_MEMBER_QUIESCING;
+		ctx->outstanding++;
+		rc = spdk_bdev_quiesce(member->lvol->bdev, &g_lvol_if, snapshot_group_quiesced, member);
+		if (rc != 0) {
+			SPDK_ERRLOG("group snapshot: can't quiesce lvol %s: %s\n",
+				    member->lvol->unique_id, spdk_strerror(-rc));
+			ctx->outstanding--;
+			member->state = SNAPSHOT_GROUP_MEMBER_IDLE;
+			snapshot_group_abort(ctx, rc);
+		}
+	}
+	ctx->submitting = false;
+	snapshot_group_advance(ctx);
+}
+
 void
 vbdev_lvol_create_bdev_clone(const char *esnap_name,
 			     struct spdk_lvol_store *lvs, const char *clone_name,
diff --git a/module/bdev/lvol/vbdev_lvol.h b/module/bdev/lvol/vbdev_lvol.h
index 288bc3d..945f0fe 100644
--- a/module/bdev/lvol/vbdev_lvol.h
+++ b/module/bdev/lvol/vbdev_lvol.h
@@ -45,6 +45,44 @@ int vbdev_lvol_create(struct spdk_lvol_store *lvs, const char *name, uint64_t sz
 void vbdev_lvol_create_snapshot(struct spdk_lvol *lvol, const char *snapshot_name,
 				spdk_lvol_op_with_handle_complete cb_fn, void *cb_arg);
 
+/* Most lvols one group snapshot may cover. */
+#define VBDEV_LVOL_SNAPSHOT_GROUP_MAX 64
+
+/**
+ * Completion of vbdev_lvol_create_snapshot_group().
+ *
+ * \param cb_arg The caller's argument.
+ * \param snapshots One entry per requested lvol, in request order: the snapshot taken, or NULL
+ * if none was. On failure some may still have been taken (the caller deletes them). Valid only
+ * during the callback.
+ * \param lvolerrno 0 on success, negative errno otherwise (-ETIMEDOUT: the lvols' outstanding
+ * I/O did not drain within the quiesce timeout; no snapshot was taken).
+ */
+typedef void (*vbdev_lvol_snapshot_group_cb)(void *cb_arg, struct spdk_lvol **snapshots,
+		int lvolerrno);
+
+/**
+ * Snapshot several lvols at one point in time (a crash-consistent group snapshot).
+ *
+ * I/O to all the lvols' bdevs is quiesced first: the call waits for I/O submitted earlier to
+ * complete and queues new I/O. Once every bdev is quiesced the snapshots are created one after
+ * another, then all bdevs are unquiesced and the queued I/O runs. No write submitted after the
+ * first bdev was quiesced is in any snapshot, and every write completed before the call is in
+ * its lvol's snapshot. If the bdevs aren't all quiesced within quiesce_timeout_ms (0: no
+ * limit), the call fails with -ETIMEDOUT without taking snapshots. In every case all bdevs are
+ * unquiesced before cb_fn runs.
+ *
+ * \param lvols The lvols, each with a registered bdev, no lvol twice.
+ * \param snapshot_names The snapshot names, one per lvol.
+ * \param num Number of lvols (1 to VBDEV_LVOL_SNAPSHOT_GROUP_MAX).
+ * \param quiesce_timeout_ms Limit for quiescing all bdevs, in milliseconds; 0 for none.
+ * \param cb_fn Completion callback, always called (possibly before this function returns).
+ * \param cb_arg Argument for cb_fn.
+ */
+void vbdev_lvol_create_snapshot_group(struct spdk_lvol **lvols, const char **snapshot_names,
+				      size_t num, uint32_t quiesce_timeout_ms,
+				      vbdev_lvol_snapshot_group_cb cb_fn, void *cb_arg);
+
 void vbdev_lvol_create_clone(struct spdk_lvol *lvol, const char *clone_name,
 			     spdk_lvol_op_with_handle_complete cb_fn, void *cb_arg);
 void vbdev_lvol_create_bdev_clone(const char *esnap_uuid,
diff --git a/module/bdev/lvol/vbdev_lvol_rpc.c b/module/bdev/lvol/vbdev_lvol_rpc.c
index f557bd9..fb1bf05 100644
--- a/module/bdev/lvol/vbdev_lvol_rpc.c
+++ b/module/bdev/lvol/vbdev_lvol_rpc.c
@@ -329,6 +329,105 @@ cleanup:
 
 SPDK_RPC_REGISTER("bdev_lvol_snapshot", rpc_bdev_lvol_snapshot, SPDK_RPC_RUNTIME)
 
+/* Default limit for quiescing the group, in milliseconds. */
+#define RPC_SNAPSHOT_GROUP_QUIESCE_TIMEOUT_MS 5000
+
+SPDK_STATIC_ASSERT(RPC_LVOL_SNAPSHOT_GROUP_ENTRIES_MAX <= VBDEV_LVOL_SNAPSHOT_GROUP_MAX,
+		   "the schema allows more lvols than a group snapshot takes");
+
+static void
+rpc_bdev_lvol_snapshot_group_cb(void *cb_arg, struct spdk_lvol **snapshots, int lvolerrno)
+{
+	struct rpc_bdev_lvol_snapshot_group_ctx *req = cb_arg;
+	struct spdk_json_write_ctx *w;
+	char *taken = NULL, *tmp;
+	size_t i;
+
+	if (lvolerrno == 0) {
+		w = spdk_jsonrpc_begin_result(req->request);
+		spdk_json_write_array_begin(w);
+		for (i = 0; i < req->snapshots.count; i++) {
+			spdk_json_write_string(w, snapshots[i]->unique_id);
+		}
+		spdk_json_write_array_end(w);
+		spdk_jsonrpc_end_result(req->request, w);
+		goto out;
+	}
+
+	/* Name the snapshots that were taken anyway, so the caller can delete them. */
+	for (i = 0; snapshots != NULL && i < req->snapshots.count; i++) {
+		if (snapshots[i] == NULL) {
+			continue;
+		}
+		tmp = spdk_sprintf_alloc("%s%s%s", taken ? taken : "", taken ? ", " : "",
+					 req->snapshots.items[i].snapshot_name);
+		free(taken);
+		taken = tmp;
+		if (taken == NULL) {
+			break;
+		}
+	}
+	if (taken != NULL) {
+		spdk_jsonrpc_send_error_response_fmt(req->request, lvolerrno, "%s (snapshots taken: %s)",
+						     spdk_strerror(-lvolerrno), taken);
+		free(taken);
+	} else {
+		spdk_jsonrpc_send_error_response(req->request, lvolerrno, spdk_strerror(-lvolerrno));
+	}
+out:
+	free_rpc_bdev_lvol_snapshot_group_heap(req);
+}
+
+static void
+rpc_bdev_lvol_snapshot_group(struct spdk_jsonrpc_request *request,
+			     const struct spdk_json_val *params)
+{
+	struct rpc_bdev_lvol_snapshot_group_ctx *req;
+	struct spdk_lvol *lvols[RPC_LVOL_SNAPSHOT_GROUP_ENTRIES_MAX];
+	const char *names[RPC_LVOL_SNAPSHOT_GROUP_ENTRIES_MAX];
+	struct spdk_bdev *bdev;
+	size_t i;
+
+	req = calloc(1, sizeof(*req));
+	if (req == NULL) {
+		spdk_jsonrpc_send_error_response(request, -ENOMEM, spdk_strerror(ENOMEM));
+		return;
+	}
+	req->quiesce_timeout_ms = RPC_SNAPSHOT_GROUP_QUIESCE_TIMEOUT_MS;
+
+	if (spdk_json_decode_object(params, rpc_bdev_lvol_snapshot_group_decoders,
+				    SPDK_COUNTOF(rpc_bdev_lvol_snapshot_group_decoders), req)) {
+		spdk_jsonrpc_send_error_response(request, SPDK_JSONRPC_ERROR_INVALID_PARAMS,
+						 "spdk_json_decode_object failed");
+		free_rpc_bdev_lvol_snapshot_group_heap(req);
+		return;
+	}
+	if (req->snapshots.count == 0) {
+		spdk_jsonrpc_send_error_response(request, SPDK_JSONRPC_ERROR_INVALID_PARAMS,
+						 "snapshots must not be empty");
+		free_rpc_bdev_lvol_snapshot_group_heap(req);
+		return;
+	}
+
+	for (i = 0; i < req->snapshots.count; i++) {
+		bdev = spdk_bdev_get_by_name(req->snapshots.items[i].lvol_name);
+		lvols[i] = bdev ? vbdev_lvol_get_from_bdev(bdev) : NULL;
+		if (lvols[i] == NULL) {
+			spdk_jsonrpc_send_error_response_fmt(request, -ENODEV, "lvol %s does not exist",
+							     req->snapshots.items[i].lvol_name);
+			free_rpc_bdev_lvol_snapshot_group_heap(req);
+			return;
+		}
+		names[i] = req->snapshots.items[i].snapshot_name;
+	}
+
+	req->request = request;
+	vbdev_lvol_create_snapshot_group(lvols, names, req->snapshots.count, req->quiesce_timeout_ms,
