+/*
+ * Group snapshots: lvol bdevs the test looks up by name, and bdev quiesce stubs whose
+ * completions are delivered by poll_threads(). The quiesce of g_ut_quiesce_hold completes only
+ * when ut_release_held_quiesce() is called; that of g_ut_quiesce_fail fails with -EIO.
+ */
+#define UT_GROUP_MAX 4
+static struct spdk_bdev *g_ut_group_bdevs[UT_GROUP_MAX];
+static int g_ut_quiesced;
+static int g_ut_quiesce_calls;
+static int g_ut_unquiesce_calls;
+static int g_ut_quiesced_at_snapshot = -1;
+static const char *g_ut_snapshot_fail;
+static struct spdk_bdev *g_ut_quiesce_hold;
+static struct spdk_bdev *g_ut_quiesce_fail;
+static spdk_bdev_quiesce_cb g_ut_held_cb;
+static void *g_ut_held_arg;
+
+struct ut_quiesce_cpl {
+	spdk_bdev_quiesce_cb	cb_fn;
+	void			*cb_arg;
+	int			status;
+};
+
+static void
+ut_quiesce_cpl_msg(void *arg)
+{
+	struct ut_quiesce_cpl *cpl = arg;
+
+	cpl->cb_fn(cpl->cb_arg, cpl->status);
+	free(cpl);
+}
+
+static void
+ut_send_quiesce_cpl(spdk_bdev_quiesce_cb cb_fn, void *cb_arg, int status)
+{
+	struct ut_quiesce_cpl *cpl = calloc(1, sizeof(*cpl));
+
+	SPDK_CU_ASSERT_FATAL(cpl != NULL);
+	cpl->cb_fn = cb_fn;
+	cpl->cb_arg = cb_arg;
+	cpl->status = status;
+	spdk_thread_send_msg(spdk_get_thread(), ut_quiesce_cpl_msg, cpl);
+}
+
+int
+spdk_bdev_quiesce(struct spdk_bdev *bdev, struct spdk_bdev_module *module,
+		  spdk_bdev_quiesce_cb cb_fn, void *cb_arg)
+{
+	CU_ASSERT(module == &g_lvol_if);
+	g_ut_quiesce_calls++;
+	if (bdev == g_ut_quiesce_fail) {
+		ut_send_quiesce_cpl(cb_fn, cb_arg, -EIO);
+		return 0;
+	}
+	if (bdev == g_ut_quiesce_hold) {
+		CU_ASSERT(g_ut_held_cb == NULL);
+		g_ut_held_cb = cb_fn;
+		g_ut_held_arg = cb_arg;
+		return 0;
+	}
+	g_ut_quiesced++;
+	ut_send_quiesce_cpl(cb_fn, cb_arg, 0);
+	return 0;
+}
+
+static void
+ut_release_held_quiesce(void)
+{
+	SPDK_CU_ASSERT_FATAL(g_ut_held_cb != NULL);
+	g_ut_quiesced++;
+	ut_send_quiesce_cpl(g_ut_held_cb, g_ut_held_arg, 0);
+	g_ut_held_cb = NULL;
+	g_ut_held_arg = NULL;
+}
+
+int
+spdk_bdev_unquiesce(struct spdk_bdev *bdev, struct spdk_bdev_module *module,
+		    spdk_bdev_quiesce_cb cb_fn, void *cb_arg)
+{
+	CU_ASSERT(module == &g_lvol_if);
+	g_ut_unquiesce_calls++;
+	g_ut_quiesced--;
+	CU_ASSERT(g_ut_quiesced >= 0);
+	ut_send_quiesce_cpl(cb_fn, cb_arg, 0);
+	return 0;
+}
