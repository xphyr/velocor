+static struct spdk_lvol *g_ut_group_snaps[UT_GROUP_MAX];
+static int g_ut_group_status;
+static bool g_ut_group_done;
+
+static void
+ut_snapshot_group_cb(void *cb_arg, struct spdk_lvol **snapshots, int lvolerrno)
+{
+	size_t num = *(size_t *)cb_arg, i;
+
+	CU_ASSERT(!g_ut_group_done);
+	g_ut_group_done = true;
+	g_ut_group_status = lvolerrno;
+	for (i = 0; i < num; i++) {
+		g_ut_group_snaps[i] = snapshots ? snapshots[i] : NULL;
+	}
+}
+
+static void
+ut_snapshot_group_reset(void)
+{
+	memset(g_ut_group_snaps, 0, sizeof(g_ut_group_snaps));
+	g_ut_group_status = 0xbad;
+	g_ut_group_done = false;
+	g_ut_quiesce_calls = 0;
+	g_ut_unquiesce_calls = 0;
+	g_ut_quiesced_at_snapshot = -1;
+	g_ut_snapshot_fail = NULL;
+	g_ut_quiesce_hold = NULL;
+	g_ut_quiesce_fail = NULL;
+}
+
+static void
+ut_snapshot_group_destroy_snaps(size_t num)
+{
+	size_t i;
+
+	for (i = 0; i < num; i++) {
+		if (g_ut_group_snaps[i] != NULL) {
+			vbdev_lvol_destroy(g_ut_group_snaps[i], lvol_store_op_complete, NULL);
+			g_ut_group_snaps[i] = NULL;
+		}
+	}
+	poll_threads();
+}
+
+static void
+ut_lvol_snapshot_group(void)
+{
+	struct spdk_lvol_store *lvs;
+	struct spdk_lvol *lvols[3], *dup[2];
+	const char *names[3] = { "snap0", "snap1", "snap2" };
+	size_t num = 3, num_dup = 2, i;
+	int rc;
+
+	ut_init_bdev(DEFAULT_BDEV_NAME, DEFAULT_BDEV_UUID);
+	rc = vbdev_lvs_create(DEFAULT_BDEV_NAME, "lvs", 0, LVS_CLEAR_WITH_UNMAP, 0,
+			      lvol_store_op_with_handle_complete, NULL);
+	CU_ASSERT(rc == 0);
+	SPDK_CU_ASSERT_FATAL(g_lvol_store != NULL);
+	lvs = g_lvol_store;
+
+	for (i = 0; i < 3; i++) {
+		char name[16];
+
+		snprintf(name, sizeof(name), "lvol%zu", i);
+		g_lvol = NULL;
+		rc = vbdev_lvol_create(lvs, name, 10, false, LVOL_CLEAR_WITH_DEFAULT,
+				       vbdev_lvol_create_complete, NULL);
+		SPDK_CU_ASSERT_FATAL(rc == 0);
+		SPDK_CU_ASSERT_FATAL(g_lvol != NULL && g_lvol->bdev != NULL);
+		lvols[i] = g_lvol;
+		/* The bdev is named after unique_id; give each its own. */
+		snprintf(lvols[i]->unique_id, sizeof(lvols[i]->unique_id), "ut-group-%zu", i);
+		g_ut_group_bdevs[i] = lvols[i]->bdev;
+	}
+
+	/* Success: snapshots taken only while all three are quiesced, then all unquiesced. */
+	ut_snapshot_group_reset();
+	vbdev_lvol_create_snapshot_group(lvols, names, num, 0, ut_snapshot_group_cb, &num);
+	CU_ASSERT(!g_ut_group_done);
+	poll_threads();
+	CU_ASSERT(g_ut_group_done);
+	CU_ASSERT(g_ut_group_status == 0);
+	CU_ASSERT(g_ut_quiesce_calls == 3);
+	CU_ASSERT(g_ut_unquiesce_calls == 3);
+	CU_ASSERT(g_ut_quiesced_at_snapshot == 3);
+	CU_ASSERT(g_ut_quiesced == 0);
+	for (i = 0; i < 3; i++) {
+		SPDK_CU_ASSERT_FATAL(g_ut_group_snaps[i] != NULL);
+		CU_ASSERT(strcmp(g_ut_group_snaps[i]->name, names[i]) == 0);
+	}
+	ut_snapshot_group_destroy_snaps(num);
+
+	/* The same lvol twice is refused before anything is quiesced. */
+	ut_snapshot_group_reset();
+	dup[0] = lvols[0];
+	dup[1] = lvols[0];
+	vbdev_lvol_create_snapshot_group(dup, names, num_dup, 0, ut_snapshot_group_cb, &num_dup);
+	CU_ASSERT(g_ut_group_done);
+	CU_ASSERT(g_ut_group_status == -EINVAL);
+	CU_ASSERT(g_ut_quiesce_calls == 0);
+
+	/* No lvols, or too many: refused. */
+	ut_snapshot_group_reset();
+	vbdev_lvol_create_snapshot_group(lvols, names, 0, 0, ut_snapshot_group_cb, &num);
+	CU_ASSERT(g_ut_group_done && g_ut_group_status == -EINVAL);
+	ut_snapshot_group_reset();
+	vbdev_lvol_create_snapshot_group(lvols, names, VBDEV_LVOL_SNAPSHOT_GROUP_MAX + 1, 0,
+					 ut_snapshot_group_cb, &num);
+	CU_ASSERT(g_ut_group_done && g_ut_group_status == -EINVAL);
+
+	/*
+	 * One bdev's I/O doesn't drain within the timeout: the others are unquiesced at the
+	 * timeout (their hosts resume), no snapshot is taken, and the call completes once the late
+	 * quiesce has completed and been undone.
+	 */
+	ut_snapshot_group_reset();
+	g_ut_quiesce_hold = lvols[1]->bdev;
+	vbdev_lvol_create_snapshot_group(lvols, names, num, 100, ut_snapshot_group_cb, &num);
+	poll_threads();
+	CU_ASSERT(!g_ut_group_done);
+	CU_ASSERT(g_ut_quiesced == 2);
+	spdk_delay_us(99 * 1000);
+	poll_threads();
+	CU_ASSERT(g_ut_quiesced == 2);
+	spdk_delay_us(2 * 1000);
+	poll_threads();
+	CU_ASSERT(!g_ut_group_done);
+	CU_ASSERT(g_ut_quiesced == 0);
+	CU_ASSERT(g_ut_unquiesce_calls == 2);
+	ut_release_held_quiesce();
+	poll_threads();
+	CU_ASSERT(g_ut_group_done);
+	CU_ASSERT(g_ut_group_status == -ETIMEDOUT);
+	CU_ASSERT(g_ut_unquiesce_calls == 3);
+	CU_ASSERT(g_ut_quiesced == 0);
+	CU_ASSERT(g_ut_quiesced_at_snapshot == -1);
+	for (i = 0; i < 3; i++) {
+		CU_ASSERT(g_ut_group_snaps[i] == NULL);
+	}
+
+	/* Without a timeout, a slow quiesce is waited for. */
+	ut_snapshot_group_reset();
+	g_ut_quiesce_hold = lvols[2]->bdev;
+	vbdev_lvol_create_snapshot_group(lvols, names, num, 0, ut_snapshot_group_cb, &num);
+	spdk_delay_us(60 * 1000 * 1000);
+	poll_threads();
+	CU_ASSERT(!g_ut_group_done);
+	ut_release_held_quiesce();
+	poll_threads();
+	CU_ASSERT(g_ut_group_done);
+	CU_ASSERT(g_ut_group_status == 0);
+	CU_ASSERT(g_ut_quiesced_at_snapshot == 3);
+	CU_ASSERT(g_ut_quiesced == 0);
+	ut_snapshot_group_destroy_snaps(num);
+
+	/* A quiesce fails: the others are unquiesced, no snapshot. */
+	ut_snapshot_group_reset();
+	g_ut_quiesce_fail = lvols[2]->bdev;
+	vbdev_lvol_create_snapshot_group(lvols, names, num, 1000, ut_snapshot_group_cb, &num);
+	poll_threads();
+	CU_ASSERT(g_ut_group_done);
+	CU_ASSERT(g_ut_group_status == -EIO);
+	CU_ASSERT(g_ut_quiesced == 0);
+	CU_ASSERT(g_ut_unquiesce_calls == 2);
+	CU_ASSERT(g_ut_quiesced_at_snapshot == -1);
+
+	/* The second snapshot fails: the first is reported (for the caller to delete), the third
+	 * isn't attempted, and everything is unquiesced. */
+	ut_snapshot_group_reset();
+	g_ut_snapshot_fail = "snap1";
+	vbdev_lvol_create_snapshot_group(lvols, names, num, 1000, ut_snapshot_group_cb, &num);
+	poll_threads();
+	CU_ASSERT(g_ut_group_done);
+	CU_ASSERT(g_ut_group_status == -ENOSPC);
+	CU_ASSERT(g_ut_group_snaps[0] != NULL);
+	CU_ASSERT(g_ut_group_snaps[1] == NULL);
+	CU_ASSERT(g_ut_group_snaps[2] == NULL);
+	CU_ASSERT(g_ut_quiesced == 0);
+	CU_ASSERT(g_ut_unquiesce_calls == 3);
+	ut_snapshot_group_destroy_snaps(num);
+
+	/* The timer of an operation that finished must not fire later. */
+	spdk_delay_us(10 * 1000 * 1000);
+	poll_threads();
+
+	ut_snapshot_group_reset();
+	for (i = 0; i < 3; i++) {
+		g_ut_group_bdevs[i] = NULL;
+		vbdev_lvol_destroy(lvols[i], lvol_store_op_complete, NULL);
+	}
+	poll_threads();
+	vbdev_lvs_destruct(lvs, lvol_store_op_complete, NULL);
+	CU_ASSERT(g_lvserrno == 0);
+	CU_ASSERT(g_lvol_store == NULL);
+}
