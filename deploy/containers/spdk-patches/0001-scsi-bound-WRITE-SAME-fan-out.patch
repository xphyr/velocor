From: Velocor <noreply@velocor.invalid>
Subject: [PATCH] scsi: bound WRITE SAME fan-out; zero WRITE SAME as WRITE ZEROES

WRITE SAME is executed as one single-block write per block, and bdev_scsi_split()
submits children until the bdev_io pool returns -ENOMEM. One 4 MiB WRITE SAME on a
512-byte-block LUN is 8192 bdev I/Os; Linux zeroing (BLKZEROOUT, mkfs) sends up to the
queue depth of them. That empties the global bdev_io pool, and I/O that another thread
needs to finish the writes can starve forever: io_wait entries are only woken by a
bdev_io freed on the waiting thread. Reproduced on a thin lvol over raid1 after a
whole-device UNMAP: the writes need cluster allocations whose metadata writes run on the
blobstore md thread, which waits for a bdev_io that never comes; 24 parallel 4 MiB WRITE
SAMEs hang the LUN with no error logged (16 complete in 1 s; 32 on allocated clusters
complete in 2 s).

- A WRITE SAME of an all-zero block without LBDATA/PBDATA is issued as a single
  spdk_bdev_write_zeroes_blocks() (emulated by the bdev layer if unsupported).
- Split commands (UNMAP, other WRITE SAMEs) keep at most SCSI_SPLIT_MAX_OUTSTANDING
  children in flight.
- bdev_scsi_split() results from the -ENOMEM resubmission and from the child completion
  path were ignored: a split ending there with an error (a child failing to submit)
  never completed the SCSI task. Same for bdev_scsi_process_block_resubmit().

Unit tests: write_same_zero_test, write_same_split_cap_test, write_same_split_error_test.

Applies to SPDK v26.09 (0bbb7fe4dccfb31e8d446da8822360704949d1e9); lib/scsi/scsi_bdev.c
is unchanged on master as of 2026-11-17.
---
--- a/lib/scsi/scsi_bdev.c
+++ b/lib/scsi/scsi_bdev.c
@@ -22,6 +22,13 @@
 #define DEFAULT_DISK_ROTATION_RATE	1	/* Non-rotating medium */
 #define DEFAULT_DISK_FORM_FACTOR	0x02	/* 3.5 inch */
 #define DEFAULT_MAX_UNMAP_BLOCK_DESCRIPTOR_COUNT	256
+/*
+ * Maximum child bdev I/Os a split SCSI command (UNMAP, WRITE SAME) keeps in flight. Without a
+ * cap, one WRITE SAME submits a single-block write per block until the bdev_io pool is empty;
+ * a few in parallel can then starve I/O that other threads need to make progress (e.g. the
+ * blobstore metadata writes of a thin lvol's cluster allocation), which never resumes.
+ */
+#define SCSI_SPLIT_MAX_OUTSTANDING	16
 
 #define INQUIRY_OFFSET(field)		offsetof(struct spdk_scsi_cdb_inquiry_data, field) + \
 					SPDK_SIZEOF_MEMBER(struct spdk_scsi_cdb_inquiry_data, field)
@@ -1368,8 +1375,11 @@
 bdev_scsi_split_resubmit(void *arg)
 {
 	struct spdk_bdev_scsi_split_ctx	*ctx = arg;
+	struct spdk_scsi_task		*task = ctx->task;
 
-	bdev_scsi_split(ctx);
+	if (bdev_scsi_split(ctx) == SPDK_SCSI_TASK_COMPLETE) {
+		scsi_lun_complete_task(task->lun, task);
+	}
 }
 
 static int
@@ -1379,7 +1389,7 @@
 	uint8_t opcode = task->cdb[0];
 	int rc = 0;
 
-	while (ctx->remaining_count != 0) {
+	while (ctx->remaining_count != 0 && ctx->outstanding_count < SCSI_SPLIT_MAX_OUTSTANDING) {
 		rc = ctx->fn(ctx);
 		if (rc == 0) {
 			ctx->current_count++;
@@ -1450,8 +1460,10 @@
 		return;
 	}
 
-	/* Continue with splitting process. */
-	bdev_scsi_split(ctx);
+	/* Continue with splitting process; it may also end here (a child failed to submit). */
+	if (bdev_scsi_split(ctx) == SPDK_SCSI_TASK_COMPLETE) {
+		scsi_lun_complete_task(task->lun, task);
+	}
 }
 
 static int
@@ -1574,6 +1586,27 @@
 				       offset_blocks, 1, bdev_scsi_task_complete_split_cmd, ctx);
 }
 
+/* WRITE SAME (10)/(16) byte 1 */
+#define SCSI_WRITE_SAME_LBDATA	(1u << 1)
+#define SCSI_WRITE_SAME_PBDATA	(1u << 2)
+
+static bool
+bdev_scsi_task_data_is_zero(struct spdk_scsi_task *task)
+{
+	uint32_t remaining = task->length;
+	int i;
+
+	for (i = 0; i < task->iovcnt && remaining > 0; i++) {
+		size_t len = spdk_min(task->iovs[i].iov_len, remaining);
+
+		if (task->iovs[i].iov_base == NULL || !spdk_mem_all_zero(task->iovs[i].iov_base, len)) {
+			return false;
+		}
+		remaining -= len;
+	}
+	return remaining == 0;
+}
+
 static int
 bdev_scsi_write_same(struct spdk_bdev *bdev, struct spdk_bdev_desc *bdev_desc,
 		     struct spdk_io_channel *bdev_ch, struct spdk_scsi_task *task,
@@ -1633,6 +1666,28 @@
 	SPDK_DEBUGLOG(scsi, "Writesame: lba=%"PRIu64", len=%"PRIu64"\n",
 		      offset_blocks, num_blocks);
 
+	/*
+	 * A WRITE SAME of an all-zero block without LBDATA/PBDATA writes zeroes: issue it as a single
+	 * WRITE ZEROES (emulated by the bdev layer where unsupported) instead of one write per block.
+	 * The UNMAP bit permits but doesn't require deallocation, so writing zeroes satisfies it too.
+	 */
+	if (!(flags & (SCSI_WRITE_SAME_PBDATA | SCSI_WRITE_SAME_LBDATA)) && bdev_scsi_task_data_is_zero(task)) {
+		int rc;
+
+		rc = spdk_bdev_write_zeroes_blocks(bdev_desc, bdev_ch, offset_blocks, num_blocks,
+						   bdev_scsi_task_complete_cmd, task);
+		if (rc == 0) {
+			task->data_transferred = task->length;
+			return SPDK_SCSI_TASK_PENDING;
+		}
+		if (rc == -ENOMEM) {
+			bdev_scsi_queue_io(task, bdev_scsi_process_block_resubmit, task);
+			return SPDK_SCSI_TASK_PENDING;
+		}
+		SPDK_ERRLOG("spdk_bdev_write_zeroes_blocks() failed: %d\n", rc);
+		goto check_condition;
+	}
+
 	ctx = calloc(1, sizeof(*ctx));
 	if (!ctx) {
 		SPDK_ERRLOG("No enough memory on SCSI WRITE SAME\n");
@@ -1840,7 +1895,9 @@
 {
 	struct spdk_scsi_task *task = arg;
 
-	bdev_scsi_process_block(task);
+	if (bdev_scsi_process_block(task) == SPDK_SCSI_TASK_COMPLETE) {
+		scsi_lun_complete_task(task->lun, task);
+	}
 }
 
 static int
--- a/test/unit/lib/scsi/scsi_bdev.c/scsi_bdev_ut.c
+++ b/test/unit/lib/scsi/scsi_bdev.c/scsi_bdev_ut.c
@@ -26,6 +26,9 @@
 int g_pending_bdev_io_count  = 0;
 bool g_bdev_io_pool_full = false;
 int g_bdev_io_pool_count = -1;
+int g_writev_count = 0;
+int g_write_zeroes_count = 0;
+int g_writev_fail_at = -1;	/* fail the writev after N successful ones with -EIO */
 
 bool
 spdk_bdev_io_type_supported(struct spdk_bdev *bdev, enum spdk_bdev_io_type io_type)
@@ -250,7 +253,31 @@
 			uint64_t offset_blocks, uint64_t num_blocks,
 			spdk_bdev_io_completion_cb cb, void *cb_arg)
 {
-	return _spdk_bdev_io_op(cb, cb_arg);
+	int rc;
+
+	/* Inject the failure into a submission that would otherwise succeed. */
+	if (g_writev_fail_at == g_writev_count && !g_bdev_io_pool_full && g_bdev_io_pool_count != 0) {
+		return -EIO;
+	}
+	rc = _spdk_bdev_io_op(cb, cb_arg);
+	if (rc == 0) {
+		g_writev_count++;
+	}
+	return rc;
+}
+
+int
+spdk_bdev_write_zeroes_blocks(struct spdk_bdev_desc *desc, struct spdk_io_channel *ch,
+			      uint64_t offset_blocks, uint64_t num_blocks,
+			      spdk_bdev_io_completion_cb cb, void *cb_arg)
+{
+	int rc;
+
+	rc = _spdk_bdev_io_op(cb, cb_arg);
+	if (rc == 0) {
+		g_write_zeroes_count++;
+	}
+	return rc;
 }
 
 int
@@ -1126,6 +1153,153 @@
 	ut_put_task(&task);
 }
 
+static void
+ut_write_same_task(struct spdk_scsi_task *task, struct spdk_scsi_lun *lun, uint8_t *cdb,
+		   uint8_t *data, uint32_t lba, uint16_t num_blocks)
+{
+	ut_init_task(task);
+	task->lun = lun;
+	task->cdb = cdb;
+	memset(cdb, 0, 16);
+	cdb[0] = SPDK_SBC_WRITE_SAME_10;
+	to_be32(&cdb[2], lba);
+	to_be16(&cdb[7], num_blocks);
+	task->dxfer_dir = SPDK_SCSI_DIR_TO_DEV;
+	task->transfer_len = 512;
+	task->offset = 0;
+	task->length = 512;
+	spdk_scsi_task_set_data(task, data, 512);
+	task->status = SPDK_SCSI_STATUS_GOOD;
+}
+
+static void
+ut_write_same_reset(void)
+{
+	g_scsi_cb_called = 0;
+	g_writev_count = 0;
+	g_write_zeroes_count = 0;
+	g_writev_fail_at = -1;
+	g_bdev_io_pool_count = -1;
+	g_bdev_io_pool_full = false;
+}
+
+/* A zero-filled WRITE SAME is one WRITE ZEROES, not a write per block. */
+static void
+write_same_zero_test(void)
+{
+	struct spdk_bdev bdev = { .blocklen = 512 };
+	struct spdk_scsi_lun lun = { .bdev = &bdev };
+	struct spdk_scsi_task task;
+	uint8_t cdb[16];
+	uint8_t data[512] = {};
+	int rc;
+
+	g_test_bdev_num_blocks = 512 * 1024 * 1024;
+	ut_write_same_reset();
+
+	ut_write_same_task(&task, &lun, cdb, data, 64, 8192);
+	rc = bdev_scsi_execute(&task);
+	CU_ASSERT(rc == SPDK_SCSI_TASK_PENDING);
+	CU_ASSERT(g_outstanding_bdev_io_count == 1);
+	CU_ASSERT(g_write_zeroes_count == 1);
+	CU_ASSERT(g_writev_count == 0);
+
+	ut_bdev_io_flush();
+	CU_ASSERT(g_scsi_cb_called == 1);
+	CU_ASSERT(task.status == SPDK_SCSI_STATUS_GOOD);
+	CU_ASSERT(g_write_zeroes_count == 1);
+	CU_ASSERT(g_writev_count == 0);
+	ut_put_task(&task);
+
+	/* With the bdev_io pool exhausted, it waits and resumes from the io_wait queue. */
+	ut_write_same_reset();
+	ut_write_same_task(&task, &lun, cdb, data, 64, 8192);
+	g_bdev_io_pool_full = true;
+	rc = bdev_scsi_execute(&task);
+	CU_ASSERT(rc == SPDK_SCSI_TASK_PENDING);
+	CU_ASSERT(g_outstanding_bdev_io_count == 0);
+	CU_ASSERT(g_pending_bdev_io_count == 1);
+
+	ut_bdev_io_flush();
+	CU_ASSERT(g_scsi_cb_called == 1);
+	CU_ASSERT(task.status == SPDK_SCSI_STATUS_GOOD);
+	CU_ASSERT(g_write_zeroes_count == 1);
+	ut_put_task(&task);
+
+	/* LBDATA asks for per-block content: not a plain zero fill, so it is split. */
+	ut_write_same_reset();
+	ut_write_same_task(&task, &lun, cdb, data, 64, 4);
+	cdb[1] = 0x02;
+	rc = bdev_scsi_execute(&task);
+	CU_ASSERT(rc == SPDK_SCSI_TASK_PENDING);
+	ut_bdev_io_flush();
+	CU_ASSERT(g_scsi_cb_called == 1);
+	CU_ASSERT(g_write_zeroes_count == 0);
+	CU_ASSERT(g_writev_count == 4);
+	ut_put_task(&task);
+	ut_write_same_reset();
+}
+
+/* A non-zero WRITE SAME is split, with a bounded number of child writes in flight. */
+static void
+write_same_split_cap_test(void)
+{
+	struct spdk_bdev bdev = { .blocklen = 512 };
+	struct spdk_scsi_lun lun = { .bdev = &bdev };
+	struct spdk_scsi_task task;
+	uint8_t cdb[16];
+	uint8_t data[512];
+	int rc;
+
+	g_test_bdev_num_blocks = 512 * 1024 * 1024;
+	ut_write_same_reset();
+	memset(data, 0xA5, sizeof(data));
+
+	ut_write_same_task(&task, &lun, cdb, data, 0, 40);
+	rc = bdev_scsi_execute(&task);
+	CU_ASSERT(rc == SPDK_SCSI_TASK_PENDING);
+	CU_ASSERT(g_outstanding_bdev_io_count == SCSI_SPLIT_MAX_OUTSTANDING);
+
+	ut_bdev_io_flush();
+	CU_ASSERT(g_scsi_cb_called == 1);
+	CU_ASSERT(task.status == SPDK_SCSI_STATUS_GOOD);
+	CU_ASSERT(g_writev_count == 40);
+	CU_ASSERT(g_write_zeroes_count == 0);
+	ut_put_task(&task);
+	ut_write_same_reset();
+}
+
+/* A child that fails to submit after the first batch still completes the SCSI task. */
+static void
+write_same_split_error_test(void)
+{
+	struct spdk_bdev bdev = { .blocklen = 512 };
+	struct spdk_scsi_lun lun = { .bdev = &bdev };
+	struct spdk_scsi_task task;
+	uint8_t cdb[16];
+	uint8_t data[512];
+	int rc;
+
+	g_test_bdev_num_blocks = 512 * 1024 * 1024;
+	ut_write_same_reset();
+	memset(data, 0xA5, sizeof(data));
+
+	ut_write_same_task(&task, &lun, cdb, data, 0, 40);
+	/* The pool runs dry after 16 children; the split resumes from their completions and the
+	 * first child of that second batch fails to submit. */
+	g_bdev_io_pool_count = 16;
+	g_writev_fail_at = 16;
+	rc = bdev_scsi_execute(&task);
+	CU_ASSERT(rc == SPDK_SCSI_TASK_PENDING);
+
+	ut_bdev_io_flush();
+	CU_ASSERT(g_scsi_cb_called == 1);
+	CU_ASSERT(task.status == SPDK_SCSI_STATUS_CHECK_CONDITION);
+	CU_ASSERT(g_writev_count == 16);
+	ut_put_task(&task);
+	ut_write_same_reset();
+}
+
 int
 main(int argc, char **argv)
 {
@@ -1153,6 +1327,9 @@
 	CU_ADD_TEST(suite, scsi_name_padding_test);
 	CU_ADD_TEST(suite, get_dif_ctx_test);
 	CU_ADD_TEST(suite, unmap_split_test);
+	CU_ADD_TEST(suite, write_same_zero_test);
+	CU_ADD_TEST(suite, write_same_split_cap_test);
+	CU_ADD_TEST(suite, write_same_split_error_test);
 
 	num_failures = spdk_ut_run_tests(argc, argv, NULL);
 	CU_cleanup_registry();
