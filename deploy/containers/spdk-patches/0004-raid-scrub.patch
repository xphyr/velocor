+/*
+ * Memory-backed base bdevs for the scrub test: reads and writes of a registered bdev complete
+ * through a message; a read overlapping its bad range fails until a write covers that range,
+ * like a drive remapping a sector. Unregistered bdevs keep the old stub behaviour (accepted,
+ * never completed).
+ */
+#define UT_SCRUB_MEMBERS 3
+struct ut_scrub_mem {
+	struct spdk_bdev	*bdev;
+	uint8_t			*data;
+	uint64_t		bad_offset;
+	uint64_t		bad_blocks;
+	bool			fail_writes;
+};
+static struct ut_scrub_mem g_scrub_mem[UT_SCRUB_MEMBERS];
+static uint32_t g_quiesce_range_count;
+static uint32_t g_unquiesce_range_count;
+
+struct ut_scrub_cpl {
+	spdk_bdev_io_completion_cb	cb;
+	void				*cb_arg;
+	bool				success;
+};
+
+static void
+ut_scrub_cpl_msg(void *ctx)
+{
+	struct ut_scrub_cpl *cpl = ctx;
+	struct spdk_bdev_io *bdev_io = calloc(1, sizeof(*bdev_io));
+
+	SPDK_CU_ASSERT_FATAL(bdev_io != NULL);
+	cpl->cb(bdev_io, cpl->success, cpl->cb_arg);
+	free(cpl);
+}
+
+static struct ut_scrub_mem *
+ut_scrub_mem_get(struct spdk_bdev_desc *desc)
+{
+	int i;
