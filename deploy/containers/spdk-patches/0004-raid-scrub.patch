+static struct raid_bdev *
+ut_scrub_setup(uint64_t blockcnt)
+{
+	struct rpc_bdev_raid_create_ctx req;
+	struct raid_bdev *pbdev;
+	struct spdk_bdev *base_bdev;
+	int i = 0;
+
+	struct spdk_raid_bdev_opts opts = {
+		.process_window_size_kb = RAID_BDEV_PROCESS_WINDOW_SIZE_KB_DEFAULT,
+		.process_max_bandwidth_mb_sec = RAID_BDEV_PROCESS_MAX_BANDWIDTH_MB_SEC_DEFAULT,
+	};
+
+	set_globals();
+	/* Earlier tests may leave a process bandwidth limit; the test clock doesn't advance. */
+	CU_ASSERT(raid_bdev_set_opts(&opts) == 0);
+	g_max_base_drives = UT_SCRUB_MEMBERS;
+	MOCK_SET(spdk_bdev_get_md_size, 0);
+	MOCK_SET(spdk_bdev_is_md_separate, false);
+	CU_ASSERT(raid_bdev_init() == 0);
+
+	create_raid_bdev_create_req(&req, "scrub", 0, true, 0, false);
+	TAILQ_FOREACH(base_bdev, &g_bdev_list, internal.link) {
+		base_bdev->blockcnt = blockcnt;
+		base_bdev->blocklen = g_block_len;
+		SPDK_CU_ASSERT_FATAL(i < UT_SCRUB_MEMBERS);
+		g_scrub_mem[i].bdev = base_bdev;
+		g_scrub_mem[i].data = calloc(blockcnt, g_block_len);
+		SPDK_CU_ASSERT_FATAL(g_scrub_mem[i].data != NULL);
+		i++;
+	}
+	rpc_bdev_raid_create(NULL, NULL);
+	CU_ASSERT(g_rpc_err == 0);
+	free_test_req(&req);
+
+	pbdev = raid_bdev_find_by_name("scrub");
+	SPDK_CU_ASSERT_FATAL(pbdev != NULL);
+	CU_ASSERT(pbdev->state == SPDK_BDEV_RAID_STATE_ONLINE);
+	/* Compare copies like RAID1 (the test module stands in for raid1). */
+	pbdev->level = SPDK_BDEV_RAID_LEVEL_RAID1;
+	pbdev->min_base_bdevs_operational = 1;
+	return pbdev;
+}
+
+static void
+ut_scrub_teardown(void)
+{
+	struct rpc_bdev_raid_delete_ctx destroy_req;
+	int i;
+
+	if (raid_bdev_find_by_name("scrub") != NULL) {
+		create_raid_bdev_delete_req(&destroy_req, "scrub", 0);
+		rpc_bdev_raid_delete(NULL, NULL);
+		CU_ASSERT(g_rpc_err == 0);
+		poll_app_thread();
+	}
+	verify_raid_bdev_present("scrub", false);
+	raid_bdev_exit();
+	base_bdevs_cleanup();
+	reset_globals();
+	MOCK_CLEAR(spdk_bdev_get_md_size);
+	MOCK_CLEAR(spdk_bdev_is_md_separate);
+	for (i = 0; i < UT_SCRUB_MEMBERS; i++) {
+		free(g_scrub_mem[i].data);
+	}
+	memset(g_scrub_mem, 0, sizeof(g_scrub_mem));
+}
+
+static void
+ut_scrub_fill(uint64_t blockcnt)
+{
+	uint64_t i;
+	int m;
+
+	for (i = 0; i < blockcnt * g_block_len; i++) {
+		uint8_t v = (uint8_t)(i * 7 + i / 4096);
+
+		for (m = 0; m < UT_SCRUB_MEMBERS; m++) {
+			g_scrub_mem[m].data[i] = v;
+		}
+	}
+}
+
+static bool
+ut_scrub_members_equal(uint64_t blockcnt)
+{
+	return memcmp(g_scrub_mem[0].data, g_scrub_mem[1].data, blockcnt * g_block_len) == 0 &&
+	       memcmp(g_scrub_mem[0].data, g_scrub_mem[2].data, blockcnt * g_block_len) == 0;
+}
+
+static void
+test_raid_scrub(void)
+{
+	const uint64_t blockcnt = 1024;	/* 4 windows of 1 MiB at 4 KiB blocks */
+	struct raid_bdev *pbdev;
+	struct raid_bdev_scrub_stats *st;
+	uint64_t window;
+
+	pbdev = ut_scrub_setup(blockcnt);
+	st = &pbdev->scrub_stats;
+	window = g_opts.process_window_size_kb * 1024 / g_block_len;
+	SPDK_CU_ASSERT_FATAL(window == 256);
+	CU_ASSERT(st->state == RAID_SCRUB_NONE);
+
+	/*
+	 * A mismatch on member 1 (block 300, window 1) and an unreadable range on member 2 (window
+	 * 2): the first is rewritten from member 0 in repair mode, the second always. Each window
+	 * is compared under a range quiesce.
+	 */
+	ut_scrub_fill(blockcnt);
+	g_scrub_mem[1].data[300 * g_block_len + 17] ^= 0xff;
+	g_scrub_mem[2].bad_offset = 600;
+	g_scrub_mem[2].bad_blocks = 8;
+	g_quiesce_range_count = g_unquiesce_range_count = 0;
+	CU_ASSERT(raid_bdev_scrub_start(pbdev, true, 0, 0) == 0);
+	CU_ASSERT(raid_bdev_scrub_start(pbdev, true, 0, 0) == -EBUSY);
+	CU_ASSERT(st->state == RAID_SCRUB_RUNNING);
+	poll_app_thread();
+	CU_ASSERT(pbdev->scrub == NULL);
+	CU_ASSERT(st->state == RAID_SCRUB_COMPLETED);
+	CU_ASSERT(st->status == 0);
+	CU_ASSERT(st->mirrored == true);
+	CU_ASSERT(st->offset_blocks == blockcnt);
+	CU_ASSERT(st->total_blocks == blockcnt);
+	CU_ASSERT(st->mismatched_blocks == 1);
+	CU_ASSERT(st->mismatch_repaired_blocks == 1);
+	CU_ASSERT(st->repaired_blocks == window);
+	CU_ASSERT(st->unrecoverable_blocks == 0);
+	CU_ASSERT(st->write_errors == 0);
+	CU_ASSERT(g_scrub_mem[2].bad_blocks == 0);
+	CU_ASSERT(ut_scrub_members_equal(blockcnt));
+	CU_ASSERT(g_quiesce_range_count == 4);
+	CU_ASSERT(g_unquiesce_range_count == 4);
+
+	/* Check only: a mismatch is counted, not rewritten. */
+	g_scrub_mem[2].data[5 * g_block_len] ^= 0x01;
+	g_scrub_mem[2].data[6 * g_block_len] ^= 0x01;
+	CU_ASSERT(raid_bdev_scrub_start(pbdev, false, 0, 0) == 0);
+	poll_app_thread();
+	CU_ASSERT(st->state == RAID_SCRUB_COMPLETED);
+	CU_ASSERT(st->mismatched_blocks == 2);
+	CU_ASSERT(st->mismatch_repaired_blocks == 0);
+	CU_ASSERT(!ut_scrub_members_equal(blockcnt));
+	g_scrub_mem[2].data[5 * g_block_len] ^= 0x01;
+	g_scrub_mem[2].data[6 * g_block_len] ^= 0x01;
+
+	/* No member readable: unrecoverable, nothing written. */
+	g_scrub_mem[0].bad_offset = g_scrub_mem[1].bad_offset = g_scrub_mem[2].bad_offset = 10;
+	g_scrub_mem[0].bad_blocks = g_scrub_mem[1].bad_blocks = g_scrub_mem[2].bad_blocks = 1;
+	CU_ASSERT(raid_bdev_scrub_start(pbdev, true, 0, 0) == 0);
+	poll_app_thread();
+	CU_ASSERT(st->state == RAID_SCRUB_COMPLETED);
+	CU_ASSERT(st->unrecoverable_blocks == window);
+	CU_ASSERT(st->repaired_blocks == 0);
+	CU_ASSERT(g_scrub_mem[0].bad_blocks == 1);
+	g_scrub_mem[0].bad_blocks = g_scrub_mem[1].bad_blocks = g_scrub_mem[2].bad_blocks = 0;
+
+	/*
+	 * Rate-limited to 1 MiB/s: after the first window it waits. A stop then ends it at once;
+	 * a scrub started at that offset resumes there and completes.
+	 */
+	CU_ASSERT(raid_bdev_scrub_start(pbdev, true, 1, 0) == 0);
+	poll_app_thread();
+	CU_ASSERT(pbdev->scrub != NULL);
+	CU_ASSERT(st->offset_blocks == window);
+	CU_ASSERT(raid_bdev_scrub_stop(pbdev) == 0);
+	CU_ASSERT(pbdev->scrub == NULL);
+	CU_ASSERT(st->state == RAID_SCRUB_STOPPED);
+	CU_ASSERT(st->status == -ECANCELED);
+	CU_ASSERT(raid_bdev_scrub_stop(pbdev) == -ENOENT);
+	CU_ASSERT(raid_bdev_scrub_start(pbdev, true, 0, blockcnt) == -EINVAL);
+	CU_ASSERT(raid_bdev_scrub_start(pbdev, true, 0, window) == 0);
+	poll_app_thread();
+	CU_ASSERT(st->state == RAID_SCRUB_COMPLETED);
+	CU_ASSERT(st->start_offset_blocks == window);
+	CU_ASSERT(st->offset_blocks == blockcnt);
+
+	/* A stop requested while a window is in flight takes effect after it, uncounted. */
+	CU_ASSERT(raid_bdev_scrub_start(pbdev, true, 0, 0) == 0);
+	spdk_thread_poll(g_app_thread, 1, 0);	/* start message: the first window's reads are submitted */
+	CU_ASSERT(raid_bdev_scrub_stop(pbdev) == 0);
+	CU_ASSERT(pbdev->scrub != NULL);
+	poll_app_thread();
+	CU_ASSERT(pbdev->scrub == NULL);
+	CU_ASSERT(st->state == RAID_SCRUB_STOPPED);
+	CU_ASSERT(st->offset_blocks == 0);
+
+	/* Refused with separate metadata, and while a rebuild runs. */
+	pbdev->bdev.md_len = 8;
+	CU_ASSERT(raid_bdev_scrub_start(pbdev, true, 0, 0) == -ENOTSUP);
+	pbdev->bdev.md_len = 0;
+
+	/* A member removal stops a running scrub. */
+	CU_ASSERT(raid_bdev_scrub_start(pbdev, true, 1, 0) == 0);
+	poll_app_thread();
+	CU_ASSERT(pbdev->scrub != NULL);
+	CU_ASSERT(raid_bdev_remove_base_bdev(g_scrub_mem[2].bdev, NULL, NULL) == 0);
+	poll_app_thread();
+	CU_ASSERT(pbdev->scrub == NULL);
+	CU_ASSERT(st->state == RAID_SCRUB_STOPPED);
+	CU_ASSERT(st->status == -ENODEV);
+
+	/* With two members left, a failed repair write fails the member and stops the scrub. */
+	g_scrub_mem[1].bad_offset = 0;
+	g_scrub_mem[1].bad_blocks = 1;
+	g_scrub_mem[1].fail_writes = true;
+	CU_ASSERT(raid_bdev_scrub_start(pbdev, true, 0, 0) == 0);
+	poll_app_thread();
+	CU_ASSERT(pbdev->scrub == NULL);
+	CU_ASSERT(st->write_errors == 1);
+	CU_ASSERT(st->state == RAID_SCRUB_STOPPED);
+	CU_ASSERT(st->status == -ENODEV);
+	CU_ASSERT(pbdev->base_bdev_info[1].desc == NULL);
+
+	/* One member left: a read-only scan. */
+	CU_ASSERT(raid_bdev_scrub_start(pbdev, true, 0, 0) == 0);
+	CU_ASSERT(st->mirrored == false);
+	poll_app_thread();
+	CU_ASSERT(st->state == RAID_SCRUB_COMPLETED);
+	CU_ASSERT(g_quiesce_range_count == g_unquiesce_range_count);
+
+	/* Deleting the raid bdev while a (rate-limited) scrub runs stops it first. */
+	CU_ASSERT(raid_bdev_scrub_start(pbdev, true, 1, 0) == 0);
+	poll_app_thread();
+	CU_ASSERT(pbdev->scrub != NULL);
+	ut_scrub_teardown();
+}
+
+/* The rate limit's deadline doesn't overflow when bytes_done * hz exceeds 64 bits. */
+static void
+test_raid_scrub_due_tsc(void)
+{
+	uint64_t hz = 3000000000ULL, bps = 200ULL * 1024 * 1024;
+
+	CU_ASSERT(raid_scrub_due_tsc(7, 0, bps, hz) == 7);
+	CU_ASSERT(raid_scrub_due_tsc(0, bps / 2, bps, hz) == hz / 2);
+	/* 100 GiB at 200 MiB/s: 512 s, far past the 64-bit limit of bytes_done * hz. */
+	CU_ASSERT(raid_scrub_due_tsc(1000, 100ULL << 30, bps, hz) == 1000 + 512 * hz);
+	/* 250 GiB plus half a second's worth. */
+	CU_ASSERT(raid_scrub_due_tsc(0, (250ULL << 30) + bps / 2, bps, hz) == 1280 * hz + hz / 2);
+}
+
+static void
+test_raid_scrub_stops_for_rebuild(void)
+{
+	struct raid_bdev *pbdev;
+	struct spdk_thread *process_thread;
+	uint64_t num_blocks_processed = 0;
+
+	pbdev = ut_scrub_setup(1024);
+	ut_scrub_fill(1024);
+	pbdev->module_private = &num_blocks_processed;
+
+	CU_ASSERT(raid_bdev_scrub_start(pbdev, true, 1, 0) == 0);
+	poll_app_thread();
+	CU_ASSERT(pbdev->scrub != NULL);
+
+	CU_ASSERT(raid_bdev_start_rebuild(&pbdev->base_bdev_info[0]) == 0);
+	CU_ASSERT(pbdev->scrub == NULL);
+	CU_ASSERT(pbdev->scrub_stats.state == RAID_SCRUB_STOPPED);
+	CU_ASSERT(pbdev->scrub_stats.status == -EBUSY);
+	poll_app_thread();
+	SPDK_CU_ASSERT_FATAL(pbdev->process != NULL);
+	CU_ASSERT(raid_bdev_scrub_start(pbdev, true, 0, 0) == -EBUSY);
+
+	process_thread = g_latest_thread;
+	for (int i = 0; i < 10000 && pbdev->process != NULL; i++) {
+		spdk_thread_poll(process_thread, 0, 0);
+		poll_app_thread();
+	}
+	/* Let the process thread release its channel and exit. */
+	while (spdk_thread_poll(process_thread, 0, 0) > 0) {
+		poll_app_thread();
+	}
+	CU_ASSERT(pbdev->process == NULL);
+	CU_ASSERT(num_blocks_processed == pbdev->bdev.blockcnt);
+	/* The scrub can run again once the rebuild is done. */
+	CU_ASSERT(raid_bdev_scrub_start(pbdev, true, 0, 0) == 0);
+	poll_app_thread();
+	CU_ASSERT(pbdev->scrub_stats.state == RAID_SCRUB_COMPLETED);
+	ut_scrub_teardown();
+}
