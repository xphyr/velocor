+ */
+static void
+rpc_bdev_raid_scrub_start(struct spdk_jsonrpc_request *request, const struct spdk_json_val *params)
+{
+	struct rpc_bdev_raid_scrub_start_ctx req = {};
+	struct raid_bdev *raid_bdev;
+	int rc;
+
+	req.repair = true;
+	if (spdk_json_decode_object(params, rpc_bdev_raid_scrub_start_decoders,
+				    SPDK_COUNTOF(rpc_bdev_raid_scrub_start_decoders), &req)) {
+		spdk_jsonrpc_send_error_response(request, SPDK_JSONRPC_ERROR_PARSE_ERROR,
+						 "spdk_json_decode_object failed");
+		goto cleanup;
+	}
+
+	raid_bdev = raid_bdev_find_by_name(req.name);
+	if (raid_bdev == NULL) {
+		spdk_jsonrpc_send_error_response_fmt(request, -ENODEV, "raid bdev %s is not found in config",
+						     req.name);
+		goto cleanup;
+	}
+
+	rc = raid_bdev_scrub_start(raid_bdev, req.repair, req.max_bandwidth_mb_sec,
+				   req.start_offset_blocks);
+	if (rc != 0) {
+		spdk_jsonrpc_send_error_response_fmt(request, rc, "Failed to start a scrub of %s: %s",
+						     req.name, spdk_strerror(-rc));
+		goto cleanup;
+	}
+	spdk_jsonrpc_send_bool_response(request, true);
+
+cleanup:
+	free_rpc_bdev_raid_scrub_start(&req);
+}
+SPDK_RPC_REGISTER("bdev_raid_scrub_start", rpc_bdev_raid_scrub_start, SPDK_RPC_RUNTIME)
