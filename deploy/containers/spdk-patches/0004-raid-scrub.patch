+	for (i = 0; i < UT_SCRUB_MEMBERS; i++) {
+		if (g_scrub_mem[i].bdev != NULL && (void *)g_scrub_mem[i].bdev == (void *)desc) {
+			return &g_scrub_mem[i];
+		}
+	}
+	return NULL;
+}
