@@ -2313,6 +2340,9 @@ _raid_bdev_remove_base_bdev(struct raid_base_bdev_info *base_info,
 	assert(base_info->desc);
 	base_info->remove_scheduled = true;
 
+	/* A running scrub stops after its current window (the removal's quiesce waits for it). */
