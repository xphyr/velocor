 	if (raid_bdev->state != SPDK_BDEV_RAID_STATE_ONLINE) {
 		/*
 		 * As raid bdev is not registered yet or already unregistered,
@@ -3285,6 +3315,9 @@ raid_bdev_start_rebuild(struct raid_base_bdev_info *target)
 
 	assert(spdk_get_thread() == spdk_thread_get_app_thread());
 
+	/* The rebuild target holds stale data beyond the rebuild window: never scrub against it. */
+	raid_bdev_scrub_request_stop(target->raid_bdev, -EBUSY);
+
 	process = raid_bdev_process_alloc(target->raid_bdev, RAID_PROCESS_REBUILD, target);
 	if (process == NULL) {
 		return -ENOMEM;
@@ -4207,6 +4240,605 @@ done:
 }
 
 /* Log component for bdev raid bdev module */
+
+/*
+ * Scrub: read every operational member's data area window by window. For RAID1 the copies are
+ * compared while the window's LBA range of the raid bdev is quiesced (no user write can race the
+ * comparison or a repair): a member whose read fails is rewritten from the first readable copy,
+ * and mismatched copies are counted and, in repair mode, rewritten from it (like Linux md's
+ * "repair"). Other levels get a surface scan (reads only; errors are unrecoverable). Runs on the
+ * app thread, the thread that changes raid membership, so membership can't change under it
+ * unnoticed: a member removal or a rebuild stops it after the current window, and destructing
+ * the raid bdev waits for it.
+ */
+struct raid_scrub_member {
+	struct raid_bdev_scrub		*scrub;
+	struct raid_base_bdev_info	*base_info;
+	struct spdk_io_channel		*ch;
+	void				*buf;
+	struct iovec			iov;
+	bool				read_ok;
+	/* What a write to this member repairs: read error (true) or mismatch (false). */
+	bool				repair_read_error;
+	uint64_t			mismatched;
+};
+
+struct raid_scrub_stop_waiter {
+	spdk_msg_fn			cb;
+	void				*cb_ctx;
+	TAILQ_ENTRY(raid_scrub_stop_waiter) link;
+};
+
+struct raid_bdev_scrub {
+	struct raid_bdev		*raid_bdev;
+	struct raid_scrub_member	*members;
+	uint8_t				num_members;
+	/* Compare copies under a range lock (RAID1 with more than one readable member). */
+	bool				compare;
+	uint64_t			max_window_blocks;
+	uint64_t			window_offset;
+	uint64_t			window_blocks;
+	bool				window_locked;
+	/* Member I/Os in flight. */
+	uint32_t			outstanding;
+	/* An I/O couldn't be submitted (e.g. -ENOMEM): redo the window after a pause. */
+	bool				retry;
+	bool				stopping;
+	int				stop_status;
+	struct spdk_poller		*delay_poller;
+	uint64_t			bytes_per_sec;
+	uint64_t			start_tsc;
+	uint64_t			bytes_done;
+	TAILQ_HEAD(, raid_scrub_stop_waiter) waiters;
+};
+
+#define RAID_SCRUB_RETRY_DELAY_US 1000
+
+static void raid_scrub_next_window(struct raid_bdev_scrub *scrub);
+
+const char *
+raid_bdev_scrub_state_to_str(enum raid_scrub_state state)
+{
+	switch (state) {
+	case RAID_SCRUB_NONE:
+		return "none";
+	case RAID_SCRUB_RUNNING:
+		return "running";
+	case RAID_SCRUB_COMPLETED:
+		return "completed";
+	case RAID_SCRUB_STOPPED:
+		return "stopped";
+	case RAID_SCRUB_FAILED:
+		return "failed";
+	}
+	return "unknown";
+}
+
+static bool
+raid_scrub_member_usable(struct raid_base_bdev_info *base_info)
+{
+	return base_info->desc != NULL && base_info->is_configured && !base_info->remove_scheduled &&
+	       !base_info->is_process_target;
+}
+
+static void
+raid_scrub_free(struct raid_bdev_scrub *scrub)
+{
+	uint8_t i;
+
+	for (i = 0; i < scrub->num_members; i++) {
+		if (scrub->members[i].ch != NULL) {
+			spdk_put_io_channel(scrub->members[i].ch);
+		}
+		spdk_dma_free(scrub->members[i].buf);
+	}
+	free(scrub->members);
+	free(scrub);
+}
+
+static void
+raid_scrub_finish(struct raid_bdev_scrub *scrub, int status)
+{
+	struct raid_bdev *raid_bdev = scrub->raid_bdev;
+	struct raid_bdev_scrub_stats *st = &raid_bdev->scrub_stats;
+	struct raid_scrub_stop_waiter *waiter;
+	TAILQ_HEAD(, raid_scrub_stop_waiter) waiters;
+
+	assert(!scrub->window_locked && scrub->outstanding == 0);
+	spdk_poller_unregister(&scrub->delay_poller);
+
+	if (status == 0 && st->offset_blocks >= st->total_blocks) {
+		st->state = RAID_SCRUB_COMPLETED;
+	} else if (scrub->stopping) {
+		st->state = RAID_SCRUB_STOPPED;
+		st->status = scrub->stop_status;
+	} else {
+		st->state = RAID_SCRUB_FAILED;
+		st->status = status != 0 ? status : -EIO;
+	}
+	SPDK_NOTICELOG("raid bdev %s: scrub %s at block %" PRIu64 " of %" PRIu64 " (%s): repaired %"
+		       PRIu64 ", mismatched %" PRIu64 " (repaired %" PRIu64 "), unrecoverable %" PRIu64
+		       ", write errors %" PRIu64 "\n", raid_bdev->bdev.name,
+		       raid_bdev_scrub_state_to_str(st->state), st->offset_blocks, st->total_blocks,
+		       st->status ? spdk_strerror(-st->status) : "ok", st->repaired_blocks,
+		       st->mismatched_blocks, st->mismatch_repaired_blocks, st->unrecoverable_blocks,
+		       st->write_errors);
+
+	TAILQ_INIT(&waiters);
+	TAILQ_CONCAT(&waiters, &scrub->waiters, link);
+	raid_bdev->scrub = NULL;
+	raid_scrub_free(scrub);
+
+	while ((waiter = TAILQ_FIRST(&waiters)) != NULL) {
+		TAILQ_REMOVE(&waiters, waiter, link);
+		waiter->cb(waiter->cb_ctx);
+		free(waiter);
+	}
+}
+
+static int
+raid_scrub_delay_poll(void *arg)
+{
+	struct raid_bdev_scrub *scrub = arg;
+
+	spdk_poller_unregister(&scrub->delay_poller);
+	raid_scrub_next_window(scrub);
+	return SPDK_POLLER_BUSY;
+}
+
+static void
+raid_scrub_delay(struct raid_bdev_scrub *scrub, uint64_t delay_us)
+{
+	assert(scrub->delay_poller == NULL);
+	scrub->delay_poller = SPDK_POLLER_REGISTER(raid_scrub_delay_poll, scrub, delay_us);
+	if (scrub->delay_poller == NULL) {
+		raid_scrub_finish(scrub, -ENOMEM);
+	}
+}
+
+static void
+raid_scrub_continue(struct raid_bdev_scrub *scrub)
+{
+	if (scrub->retry && !scrub->stopping) {
+		scrub->retry = false;
+		raid_scrub_delay(scrub, RAID_SCRUB_RETRY_DELAY_US);
+		return;
+	}
+	raid_scrub_next_window(scrub);
+}
+
+static void
+raid_scrub_window_unlocked(void *ctx, int status)
+{
+	struct raid_bdev_scrub *scrub = ctx;
+
+	scrub->window_locked = false;
+	if (status != 0) {
+		SPDK_ERRLOG("raid bdev %s: scrub can't unlock blocks %" PRIu64 "+%" PRIu64 ": %s\n",
+			    scrub->raid_bdev->bdev.name, scrub->window_offset, scrub->window_blocks,
+			    spdk_strerror(-status));
+		raid_scrub_finish(scrub, status);
+		return;
+	}
+	raid_scrub_continue(scrub);
+}
+
+/* The window is done (advance), or must be redone or abandoned: unlock, go on. */
+static void
+raid_scrub_window_end(struct raid_bdev_scrub *scrub, bool advance)
+{
+	struct raid_bdev *raid_bdev = scrub->raid_bdev;
+	int rc;
+
+	if (advance) {
+		raid_bdev->scrub_stats.offset_blocks = scrub->window_offset + scrub->window_blocks;
+		scrub->bytes_done += scrub->window_blocks * raid_bdev->bdev.blocklen;
+	}
+	if (!scrub->window_locked) {
+		raid_scrub_continue(scrub);
+		return;
+	}
+	rc = spdk_bdev_unquiesce_range(&raid_bdev->bdev, &g_raid_if, scrub->window_offset,
+				       scrub->window_blocks, raid_scrub_window_unlocked, scrub);
+	if (rc != 0) {
+		raid_scrub_window_unlocked(scrub, rc);
+	}
+}
+
+static void
+raid_scrub_write_done(struct spdk_bdev_io *bdev_io, bool success, void *cb_arg)
+{
+	struct raid_scrub_member *member = cb_arg;
+	struct raid_bdev_scrub *scrub = member->scrub;
+	struct raid_bdev_scrub_stats *st = &scrub->raid_bdev->scrub_stats;
+
+	spdk_bdev_free_io(bdev_io);
+	assert(scrub->outstanding > 0);
+	scrub->outstanding--;
+
+	if (success) {
+		if (member->repair_read_error) {
+			st->repaired_blocks += scrub->window_blocks;
+		} else {
+			st->mismatch_repaired_blocks += member->mismatched;
+		}
+	} else {
+		SPDK_ERRLOG("raid bdev %s: scrub can't rewrite blocks %" PRIu64 "+%" PRIu64 " on %s; "
+			    "failing it\n", scrub->raid_bdev->bdev.name, scrub->window_offset,
+			    scrub->window_blocks, member->base_info->name);
+		st->write_errors++;
+		/* Like raid1's read-error correction. The removal stops this scrub. */
+		raid_bdev_fail_base_bdev(member->base_info);
+	}
+	if (scrub->outstanding == 0) {
+		raid_scrub_window_end(scrub, !scrub->retry);
+	}
+}
+
+static void
+raid_scrub_write(struct raid_bdev_scrub *scrub, struct raid_scrub_member *member,
+		 struct raid_scrub_member *src)
+{
+	int rc;
+
+	member->iov.iov_base = src->buf;
+	member->iov.iov_len = scrub->window_blocks * scrub->raid_bdev->bdev.blocklen;
+	scrub->outstanding++;
+	rc = raid_bdev_writev_blocks_ext(member->base_info, member->ch, &member->iov, 1,
+					 scrub->window_offset, scrub->window_blocks,
+					 raid_scrub_write_done, member, NULL);
+	if (rc != 0) {
+		scrub->outstanding--;
+		scrub->retry = true;
+	}
+}
+
+static uint64_t
+raid_scrub_count_mismatches(struct raid_bdev_scrub *scrub, const void *a, const void *b)
+{
+	uint32_t blocklen = scrub->raid_bdev->bdev.blocklen;
+	uint64_t i, n = 0;
+
+	for (i = 0; i < scrub->window_blocks; i++) {
+		if (memcmp((const char *)a + i * blocklen, (const char *)b + i * blocklen, blocklen) != 0) {
+			n++;
+		}
+	}
+	return n;
+}
+
+static void
+raid_scrub_evaluate(struct raid_bdev_scrub *scrub)
+{
+	struct raid_bdev_scrub_stats *st = &scrub->raid_bdev->scrub_stats;
+	struct raid_scrub_member *src = NULL, *member;
+	uint8_t i;
+
+	if (scrub->retry || scrub->stopping) {
+		/* Redo the window (or stop) without counting a partial result. */
+		raid_scrub_window_end(scrub, false);
+		return;
+	}
+
+	if (!scrub->compare) {
+		for (i = 0; i < scrub->num_members; i++) {
+			if (!scrub->members[i].read_ok) {
+				SPDK_ERRLOG("raid bdev %s: scrub can't read blocks %" PRIu64 "+%" PRIu64
+					    " of %s\n", scrub->raid_bdev->bdev.name, scrub->window_offset,
+					    scrub->window_blocks, scrub->members[i].base_info->name);
+				st->unrecoverable_blocks += scrub->window_blocks;
+			}
+		}
+		raid_scrub_window_end(scrub, true);
+		return;
+	}
+
+	for (i = 0; i < scrub->num_members && src == NULL; i++) {
+		if (scrub->members[i].read_ok) {
+			src = &scrub->members[i];
+		}
+	}
+	if (src == NULL) {
+		SPDK_ERRLOG("raid bdev %s: scrub can't read blocks %" PRIu64 "+%" PRIu64
+			    " from any member\n", scrub->raid_bdev->bdev.name, scrub->window_offset,
+			    scrub->window_blocks);
+		st->unrecoverable_blocks += scrub->window_blocks;
+		raid_scrub_window_end(scrub, true);
+		return;
+	}
+
+	for (i = 0; i < scrub->num_members; i++) {
+		member = &scrub->members[i];
+		if (member == src) {
+			continue;
+		}
+		if (!member->read_ok) {
+			SPDK_NOTICELOG("raid bdev %s: scrub rewrites blocks %" PRIu64 "+%" PRIu64
+				       " of %s from %s after a read error\n", scrub->raid_bdev->bdev.name,
+				       scrub->window_offset, scrub->window_blocks, member->base_info->name,
+				       src->base_info->name);
+			member->repair_read_error = true;
+			raid_scrub_write(scrub, member, src);
+			continue;
+		}
+		member->mismatched = raid_scrub_count_mismatches(scrub, src->buf, member->buf);
+		if (member->mismatched == 0) {
+			continue;
+		}
+		st->mismatched_blocks += member->mismatched;
+		SPDK_NOTICELOG("raid bdev %s: scrub found %" PRIu64 " blocks in %" PRIu64 "+%" PRIu64
+			       " of %s differing from %s%s\n", scrub->raid_bdev->bdev.name,
+			       member->mismatched, scrub->window_offset, scrub->window_blocks,
+			       member->base_info->name, src->base_info->name,
+			       st->repair ? "; rewriting them" : "");
+		if (st->repair) {
+			member->repair_read_error = false;
+			raid_scrub_write(scrub, member, src);
+		}
+	}
+	if (scrub->outstanding == 0) {
+		raid_scrub_window_end(scrub, !scrub->retry);
+	}
+}
+
+static void
+raid_scrub_read_done(struct spdk_bdev_io *bdev_io, bool success, void *cb_arg)
+{
+	struct raid_scrub_member *member = cb_arg;
+	struct raid_bdev_scrub *scrub = member->scrub;
+
+	spdk_bdev_free_io(bdev_io);
+	member->read_ok = success;
+	assert(scrub->outstanding > 0);
+	if (--scrub->outstanding == 0) {
+		raid_scrub_evaluate(scrub);
+	}
+}
+
+static void
+raid_scrub_read(struct raid_bdev_scrub *scrub)
+{
+	struct raid_scrub_member *member;
+	uint8_t i;
+	int rc;
+
+	scrub->outstanding = 1;	/* held while submitting */
+	for (i = 0; i < scrub->num_members; i++) {
+		member = &scrub->members[i];
+		member->read_ok = false;
+		member->mismatched = 0;
+		member->iov.iov_base = member->buf;
+		member->iov.iov_len = scrub->window_blocks * scrub->raid_bdev->bdev.blocklen;
+		scrub->outstanding++;
+		rc = raid_bdev_readv_blocks_ext(member->base_info, member->ch, &member->iov, 1,
+						scrub->window_offset, scrub->window_blocks,
+						raid_scrub_read_done, member, NULL);
+		if (rc != 0) {
+			scrub->outstanding--;
+			scrub->retry = true;
+		}
+	}
+	if (--scrub->outstanding == 0) {
+		raid_scrub_evaluate(scrub);
+	}
+}
+
+static void
+raid_scrub_window_locked(void *ctx, int status)
+{
+	struct raid_bdev_scrub *scrub = ctx;
+
+	if (status != 0) {
+		SPDK_ERRLOG("raid bdev %s: scrub can't lock blocks %" PRIu64 "+%" PRIu64 ": %s\n",
+			    scrub->raid_bdev->bdev.name, scrub->window_offset, scrub->window_blocks,
+			    spdk_strerror(-status));
+		raid_scrub_finish(scrub, status);
+		return;
+	}
+	scrub->window_locked = true;
+	if (scrub->stopping) {
+		raid_scrub_window_end(scrub, false);
+		return;
+	}
+	raid_scrub_read(scrub);
+}
+
+/*
+ * The tick by which bytes_done may have been scrubbed at bytes_per_sec. bytes_done * hz would
+ * overflow 64 bits after a few GB at a GHz tick rate, so whole seconds are counted apart.
+ */
+static uint64_t
+raid_scrub_due_tsc(uint64_t start_tsc, uint64_t bytes_done, uint64_t bytes_per_sec, uint64_t hz)
+{
+	uint64_t secs = bytes_done / bytes_per_sec;
+	uint64_t rem = bytes_done % bytes_per_sec;
+
+	return start_tsc + secs * hz + (uint64_t)((double)rem * (double)hz / (double)bytes_per_sec);
+}
+
+static void
+raid_scrub_next_window(struct raid_bdev_scrub *scrub)
+{
+	struct raid_bdev *raid_bdev = scrub->raid_bdev;
+	struct raid_bdev_scrub_stats *st = &raid_bdev->scrub_stats;
+	int rc;
+
+	if (scrub->stopping) {
+		raid_scrub_finish(scrub, scrub->stop_status);
+		return;
+	}
+	if (st->offset_blocks >= st->total_blocks) {
+		raid_scrub_finish(scrub, 0);
+		return;
+	}
+	if (scrub->bytes_per_sec != 0) {
+		uint64_t hz = spdk_get_ticks_hz();
+		uint64_t due = raid_scrub_due_tsc(scrub->start_tsc, scrub->bytes_done,
+						  scrub->bytes_per_sec, hz);
+		uint64_t now = spdk_get_ticks();
+
+		if (now < due) {
+			raid_scrub_delay(scrub, spdk_max((due - now) * SPDK_SEC_TO_USEC / hz, 1));
+			return;
+		}
+	}
+
+	scrub->window_offset = st->offset_blocks;
+	scrub->window_blocks = spdk_min(scrub->max_window_blocks, st->total_blocks - st->offset_blocks);
+	if (!scrub->compare) {
+		raid_scrub_read(scrub);
+		return;
+	}
+	rc = spdk_bdev_quiesce_range(&raid_bdev->bdev, &g_raid_if, scrub->window_offset,
+				     scrub->window_blocks, raid_scrub_window_locked, scrub);
+	if (rc != 0) {
+		raid_scrub_window_locked(scrub, rc);
+	}
+}
+
+static void
+raid_scrub_start_msg(void *ctx)
+{
+	raid_scrub_next_window(ctx);
+}
+
+int
+raid_bdev_scrub_start(struct raid_bdev *raid_bdev, bool repair, uint32_t max_bandwidth_mb_sec,
+		      uint64_t start_offset_blocks)
+{
+	struct raid_bdev_scrub *scrub;
+	struct raid_bdev_scrub_stats *st = &raid_bdev->scrub_stats;
+	struct raid_base_bdev_info *base_info;
+	uint64_t total = UINT64_MAX, buf_size;
+	uint8_t n = 0;
+
+	assert(spdk_get_thread() == spdk_thread_get_app_thread());
+
+	if (raid_bdev->state != SPDK_BDEV_RAID_STATE_ONLINE) {
+		return -ENODEV;
+	}
+	if (raid_bdev->scrub != NULL || raid_bdev->process != NULL) {
+		return -EBUSY;
+	}
+	if (raid_bdev->bdev.md_len != 0) {
+		return -ENOTSUP;
+	}
+	RAID_FOR_EACH_BASE_BDEV(raid_bdev, base_info) {
+		if (raid_scrub_member_usable(base_info)) {
+			total = spdk_min(total, base_info->data_size);
+			n++;
+		}
+	}
+	if (n == 0) {
+		return -ENODEV;
+	}
+	if (raid_bdev->level == SPDK_BDEV_RAID_LEVEL_RAID1) {
+		total = spdk_min(total, raid_bdev->bdev.blockcnt);
+	}
+	if (start_offset_blocks >= total) {
+		return -EINVAL;
+	}
+
+	scrub = calloc(1, sizeof(*scrub));
+	if (scrub == NULL) {
+		return -ENOMEM;
+	}
+	scrub->members = calloc(n, sizeof(*scrub->members));
+	if (scrub->members == NULL) {
+		free(scrub);
+		return -ENOMEM;
+	}
+	scrub->raid_bdev = raid_bdev;
+	TAILQ_INIT(&scrub->waiters);
+	scrub->max_window_blocks = spdk_max((uint64_t)g_opts.process_window_size_kb * 1024 /
+					    raid_bdev->bdev.blocklen, 1);
+	buf_size = scrub->max_window_blocks * raid_bdev->bdev.blocklen;
+	RAID_FOR_EACH_BASE_BDEV(raid_bdev, base_info) {
+		struct raid_scrub_member *member;
+
+		if (!raid_scrub_member_usable(base_info)) {
+			continue;
+		}
+		member = &scrub->members[scrub->num_members++];
+		member->scrub = scrub;
+		member->base_info = base_info;
+		member->ch = spdk_bdev_get_io_channel(base_info->desc);
+		member->buf = spdk_dma_malloc(buf_size, 0x1000, NULL);
+		if (member->ch == NULL || member->buf == NULL) {
+			raid_scrub_free(scrub);
+			return -ENOMEM;
+		}
+	}
+	scrub->compare = raid_bdev->level == SPDK_BDEV_RAID_LEVEL_RAID1 && n > 1;
+	scrub->bytes_per_sec = (uint64_t)max_bandwidth_mb_sec * 1024 * 1024;
+	scrub->start_tsc = spdk_get_ticks();
+
+	memset(st, 0, sizeof(*st));
+	st->state = RAID_SCRUB_RUNNING;
+	st->repair = repair;
+	st->mirrored = scrub->compare;
+	st->start_offset_blocks = start_offset_blocks;
+	st->offset_blocks = start_offset_blocks;
+	st->total_blocks = total;
+	raid_bdev->scrub = scrub;
+
+	SPDK_NOTICELOG("raid bdev %s: scrub started at block %" PRIu64 " of %" PRIu64 " (%s, %u "
+		       "members%s)\n", raid_bdev->bdev.name, start_offset_blocks, total,
+		       scrub->compare ? (repair ? "compare and repair" : "compare") : "read only", n,
+		       max_bandwidth_mb_sec ? ", rate-limited" : "");
+	spdk_thread_send_msg(spdk_get_thread(), raid_scrub_start_msg, scrub);
+	return 0;
+}
+
+/* Ask a running scrub to stop; it stops after the current window. */
+static void
+raid_bdev_scrub_request_stop(struct raid_bdev *raid_bdev, int status)
+{
+	struct raid_bdev_scrub *scrub = raid_bdev->scrub;
+
+	if (scrub == NULL || scrub->stopping) {
+		return;
+	}
+	scrub->stopping = true;
+	scrub->stop_status = status;
+	if (scrub->delay_poller != NULL) {
+		/* Between windows: nothing in flight. */
+		raid_scrub_finish(scrub, status);
+	}
+}
+
+/* Stop a running scrub and call cb once it has stopped. -ENOENT if none runs. */
+static int
+raid_bdev_scrub_stop_then(struct raid_bdev *raid_bdev, spdk_msg_fn cb, void *cb_ctx)
+{
+	struct raid_scrub_stop_waiter *waiter;
+
+	if (raid_bdev->scrub == NULL) {
+		return -ENOENT;
+	}
+	waiter = calloc(1, sizeof(*waiter));
+	if (waiter == NULL) {
+		return -ENOMEM;
+	}
+	waiter->cb = cb;
+	waiter->cb_ctx = cb_ctx;
+	TAILQ_INSERT_TAIL(&raid_bdev->scrub->waiters, waiter, link);
+	raid_bdev_scrub_request_stop(raid_bdev, -ECANCELED);
+	return 0;
+}
+
+int
+raid_bdev_scrub_stop(struct raid_bdev *raid_bdev)
+{
+	assert(spdk_get_thread() == spdk_thread_get_app_thread());
+
+	if (raid_bdev->scrub == NULL) {
+		return -ENOENT;
+	}
+	raid_bdev_scrub_request_stop(raid_bdev, -ECANCELED);
+	return 0;
+}
+
