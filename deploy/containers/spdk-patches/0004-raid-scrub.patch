+	cpl = calloc(1, sizeof(*cpl));
+	SPDK_CU_ASSERT_FATAL(cpl != NULL);
+	cpl->cb = cb;
+	cpl->cb_arg = cb_arg;
+	if (write) {
+		cpl->success = !mem->fail_writes;
+		if (cpl->success) {
+			memcpy(p, iov[0].iov_base, iov[0].iov_len);
+			if (overlaps_bad) {
+				mem->bad_blocks = 0;
+			}
+		}
+	} else {
+		cpl->success = !overlaps_bad;
+		if (cpl->success) {
+			memcpy(iov[0].iov_base, p, iov[0].iov_len);
+		}
+	}
+	spdk_thread_send_msg(spdk_get_thread(), ut_scrub_cpl_msg, cpl);
+	return 0;
+}
