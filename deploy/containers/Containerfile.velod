# Control-plane container: velod (and veloctl, which the OS image copies out of this image).
#
# The Go toolchain is the official image matching go.mod's `toolchain` line, pinned by digest
# (hack/check-pins.sh enforces both), so the shipped binaries come from the same Go release CI
# tests with. The runtime follows Fedora's rolling fedora-minimal 45 (resolved to a digest per
# build by `make`, recorded in the org.opencontainers.image.base.* labels).
ARG FEDORA_MINIMAL_IMAGE=quay.io/fedora/fedora-minimal:45
FROM docker.io/library/golang:1.27.4@sha256:5f1b98fa02fe396ebce2a0227a0e08309e11792915b9dd2e1f71053d7e7e6666 AS builder

ENV CGO_ENABLED=0 GOTOOLCHAIN=local
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download

COPY . .
ARG VERSION=unknown
ARG COMMIT=unknown
ARG BUILD_TIME=unknown
RUN LDFLAGS="-s -w -X github.com/velocor/velocor/internal/version.Version=${VERSION} -X github.com/velocor/velocor/internal/version.Commit=${COMMIT} -X github.com/velocor/velocor/internal/version.BuildTime=${BUILD_TIME}" && \
    go build -trimpath -ldflags="${LDFLAGS}" -o /out/velod ./cmd/velod && \
    go build -trimpath -ldflags="${LDFLAGS}" -o /out/veloctl ./cmd/veloctl

FROM ${FEDORA_MINIMAL_IMAGE}

RUN mkdir -p /var/lib/velocor /run/velocor
COPY --from=builder /out/velod /usr/bin/velod
COPY --from=builder /out/veloctl /usr/bin/veloctl

EXPOSE 8443
# Arguments come from the quadlet (deploy/quadlets/velocor-velod.container), the only source.
ENTRYPOINT ["/usr/bin/velod"]
