# Data-plane container: SPDK v26.09 (spdk_tgt) built from source on Fedora 45.
#
# The base image is pinned by digest and the SPDK source by commit (the tag is checked against
# it), so a rebuild compiles the same SPDK. spdk_tgt's arguments come from the quadlet
# (deploy/quadlets/velocor-spdk.container), which is the only source of them.
FROM quay.io/fedora/fedora:45@sha256:e203b4174f6a2ce6c160ddc4917d85e6bfce32dfc610d953b355d63ec4c17909 AS builder

ARG SPDK_VERSION=v26.09
ARG SPDK_COMMIT=0bbb7fe4dccfb31e8d446da8822360704949d1e9

RUN dnf install -y \
      git \
      gcc \
      gcc-c++ \
      make \
      meson \
      ninja-build \
      pkgconf-pkg-config \
      python3 \
      python3-pyelftools \
      libaio-devel \
      liburing-devel \
      libuuid-devel \
      numactl-devel \
      openssl-devel \
      ncurses-devel \
      json-c-devel \
      fuse3-devel \
      cunit-devel \
      findutils \
      diffutils \
      patch && \
    dnf clean all

WORKDIR /src
RUN git clone --depth 1 --branch ${SPDK_VERSION} --recurse-submodules --shallow-submodules \
      https://github.com/spdk/spdk.git /src/spdk && \
    test "$(git -C /src/spdk rev-parse HEAD)" = "${SPDK_COMMIT}" || \
      { echo "SPDK ${SPDK_VERSION} is not commit ${SPDK_COMMIT}" >&2; exit 1; }

WORKDIR /src/spdk
# Local fixes on top of the pinned SPDK, applied in order; `git apply --check` fails the build
# if one no longer applies (e.g. after an SPDK bump). Drop a patch once it is upstream.
COPY deploy/containers/spdk-patches/ /src/spdk-patches/
RUN for p in /src/spdk-patches/*.patch; do \
      echo "Applying ${p##*/}" && git apply --check "$p" && git apply "$p" || exit 1; \
    done

RUN dnf install -y nasm autoconf automake libtool help2man python3-pyyaml python3-jinja2 python3-tabulate && dnf clean all && \
    ./configure \
      --prefix=/usr \
      --target-arch=x86-64-v2 \
      --disable-tests \
      --disable-unit-tests \
      --disable-examples \
      --with-uring \
      --with-raid5f \
      --without-isal-crypto \
      --without-crypto \
      --without-vhost \
      --without-fsdev && \
    make -j"$(nproc)" && \
    cp /src/spdk/build/bin/spdk_tgt /usr/bin/spdk_tgt && \
    strip /usr/bin/spdk_tgt && \
    cp /src/spdk/build/bin/spdk_dd /usr/bin/spdk_dd && \
    strip /usr/bin/spdk_dd

FROM quay.io/fedora/fedora:45@sha256:e203b4174f6a2ce6c160ddc4917d85e6bfce32dfc610d953b355d63ec4c17909 AS runtime

RUN dnf install -y \
      libaio \
      liburing \
      libuuid \
      numactl-libs \
      openssl-libs \
      json-c \
      fuse3-libs \
      iproute \
      procps-ng && \
    dnf clean all && \
    rm -rf /var/cache /var/log/dnf* /var/log/yum* && \
    mkdir -p /run/velocor /etc/velocor && \
    printf '{"subsystems":[{"subsystem":"iscsi","config":[{"method":"iscsi_set_options","params":{"max_sessions":16,"pdu_pool_size":2048,"immediate_data_pool_size":512,"data_out_pool_size":512}}]}]}\n' > /etc/velocor/spdk.json

COPY --from=builder /usr/bin/spdk_tgt /usr/bin/spdk_tgt

ENTRYPOINT ["/usr/bin/spdk_tgt"]

# Integration-test image (build with --target test): adds spdk_dd, which acts as a
# userspace NVMe/TCP initiator so tests can write and verify data through real exports
# without root or kernel NVMe modules. Never shipped.
FROM runtime AS test
COPY --from=builder /usr/bin/spdk_dd /usr/bin/spdk_dd

# The shipped data-plane image is the last stage, so a plain build produces it.
FROM runtime
