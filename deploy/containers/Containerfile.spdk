# Data-plane container: SPDK v26.09 (spdk_tgt) built from source on Fedora 45.
#
# The base follows Fedora's rolling 45 image (daily fixes; `make` resolves the tag to a digest
# per build and records it in the org.opencontainers.image.base.* labels). The SPDK source is
# pinned by commit (the tag is checked against it) and patched from spdk-patches/. spdk_tgt's
# arguments come from the quadlet (deploy/quadlets/velocor-spdk.container), the only source of them.
ARG FEDORA_IMAGE=quay.io/fedora/fedora:46

# Patched SPDK source and its build dependencies, shared by the shipped build and the unit tests.
FROM ${FEDORA_IMAGE} AS source

ARG SPDK_VERSION=v26.09
ARG SPDK_COMMIT=0bbb7fe4dccfb31e8d446da8822360704949d1e9

RUN dnf install -y \
      git \
      gcc \
      gcc-c++ \
      make \
      meson \
      ninja-build \
      pkgconf-pkg-config \
      python3 \
      python3-pyelftools \
      python3-pyyaml \
      python3-jinja2 \
      python3-tabulate \
      libaio-devel \
      liburing-devel \
      libuuid-devel \
      numactl-devel \
      openssl-devel \
      ncurses-devel \
      json-c-devel \
      fuse3-devel \
      cunit-devel \
      nasm \
      autoconf \
      automake \
      libtool \
      help2man \
      findutils \
      diffutils \
      patch && \
    dnf clean all

WORKDIR /src
RUN git clone --depth 1 --branch ${SPDK_VERSION} --recurse-submodules --shallow-submodules \
      https://github.com/spdk/spdk.git /src/spdk && \
    test "$(git -C /src/spdk rev-parse HEAD)" = "${SPDK_COMMIT}" || \
      { echo "SPDK ${SPDK_VERSION} is not commit ${SPDK_COMMIT}" >&2; exit 1; }

WORKDIR /src/spdk
# Local fixes on top of the pinned SPDK, applied in order; `git apply --check` fails the build
# if one no longer applies (e.g. after an SPDK bump). Drop a patch once it is upstream. Each
# patch carries unit tests; `make spdk-unit-tests` (the unit-tests stage) runs them.
COPY deploy/containers/spdk-patches/ /src/spdk-patches/
RUN for p in /src/spdk-patches/*.patch; do \
      echo "Applying ${p##*/}" && git apply --check "$p" && git apply "$p" || exit 1; \
    done

# Configure options shared by both builds (the unit-tests build adds the unit tests).
ENV SPDK_CONFIGURE="--prefix=/usr --target-arch=x86-64-v2 --disable-tests --disable-examples \
--with-uring --with-ublk --with-raid5f --without-isal-crypto --without-crypto --without-vhost --without-fsdev"

FROM source AS builder
RUN ./configure ${SPDK_CONFIGURE} --disable-unit-tests && \
    make -j"$(nproc)" && \
    cp /src/spdk/build/bin/spdk_tgt /usr/bin/spdk_tgt && \
    strip /usr/bin/spdk_tgt && \
    cp /src/spdk/build/bin/spdk_dd /usr/bin/spdk_dd && \
    strip /usr/bin/spdk_dd

# Unit tests of the SPDK libraries our patches touch (build with --target unit-tests; the build
# fails if a test fails). Never shipped.
FROM source AS unit-tests
COPY hack/spdk-patch-unit-tests.sh /usr/local/bin/spdk-patch-unit-tests
RUN ./configure ${SPDK_CONFIGURE} --enable-unit-tests && \
    make -j"$(nproc)" && \
    spdk-patch-unit-tests /src/spdk /src/spdk-patches

FROM ${FEDORA_IMAGE} AS runtime

# spdk_tgt startup configuration. generate_uuids: SPDK names an NVMe namespace's bdev by its
# NGUID or UUID, and a namespace with neither gets a random UUID at every start; RAID
# superblocks match members by bdev UUID, so a pool on such drives would never reassemble after
# a restart. With generate_uuids SPDK derives a stable one from the controller serial and the
# namespace ID instead (found on the P0-1 lab).
# sock: no zero-copy sends. The NVMe/TCP target sends a read's response only when its data
# send completes, and a zero-copy send completes when the host ACKs it: a 4K read is one TCP
# segment, which Linux hosts ACK late (delayed ACK), so every small read took ~50 ms (4K reads
# at QD1: 19 IOPS, ~2,900 without; measured from an OpenShift node, 2026-11-18).

RUN dnf install -y \
      libaio \
      liburing \
      libuuid \
      numactl-libs \
      openssl-libs \
      json-c \
      fuse3-libs \
      iproute \
      procps-ng && \
    dnf clean all && \
    rm -rf /var/cache /var/log/dnf* /var/log/yum* && \
    mkdir -p /run/velocor /etc/velocor && \
    printf '{"subsystems":[{"subsystem":"sock","config":[{"method":"sock_impl_set_options","params":{"impl_name":"posix","enable_zerocopy_send_server":false}}]},{"subsystem":"bdev","config":[{"method":"bdev_nvme_set_options","params":{"generate_uuids":true}}]},{"subsystem":"iscsi","config":[{"method":"iscsi_set_options","params":{"max_sessions":16,"pdu_pool_size":2048,"immediate_data_pool_size":512,"data_out_pool_size":512}}]}]}\n' > /etc/velocor/spdk.json

COPY --from=builder /usr/bin/spdk_tgt /usr/bin/spdk_tgt

ENTRYPOINT ["/usr/bin/spdk_tgt"]

# Integration-test image (build with --target test): adds spdk_dd, which acts as a
# userspace NVMe/TCP initiator so tests can write and verify data through real exports
# without root or kernel NVMe modules. Never shipped.
FROM runtime AS test
COPY --from=builder /usr/bin/spdk_dd /usr/bin/spdk_dd

# The shipped data-plane image is the last stage, so a plain build produces it.
FROM runtime
