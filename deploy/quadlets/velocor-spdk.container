[Unit]
Description=Velocor SPDK Data-Plane Container (spdk_tgt)
Documentation=https://spdk.io/doc/
After=network-online.target local-fs.target
Wants=network-online.target

[Container]
# Filled in by the OS image build with the embedded image, pinned by digest.
Image=@VELOCOR_SPDK_IMAGE@
ContainerName=velocor-spdk
# No AutoUpdate: restarting spdk_tgt interrupts all SAN I/O. The data plane is only updated
# explicitly (Web UI / API with allow_disruptive=true) during a maintenance window.
Network=host
SecurityLabelDisable=true
PodmanArgs=--privileged --ipc=host --pid=host
Volume=/dev:/dev:rslave
Volume=/dev/hugepages:/dev/hugepages:rw
Volume=/sys:/sys:rw
Volume=/run/velocor:/run/velocor:rw
Ulimit=memlock=-1:-1
# Give spdk_tgt time to finish in-flight I/O and close its blobstores cleanly on shutdown;
# podman's default of 10 s before SIGKILL turns every reboot into an unclean stop.
StopTimeout=120
Ulimit=nofile=1048576:1048576
Exec=-r /run/velocor/spdk.sock -m 0x1 -s 1024 --json /etc/velocor/spdk.json

[Service]
TimeoutStopSec=150
ExecStartPre=/usr/bin/mkdir -p /run/velocor
ExecStartPre=/usr/bin/rm -f /run/velocor/spdk.sock
Restart=always
RestartSec=2s

[Install]
WantedBy=multi-user.target default.target
