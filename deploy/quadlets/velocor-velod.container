[Unit]
Description=Velocor Control-Plane Container (velod)
After=network-online.target velocor-spdk.service
Wants=velocor-spdk.service

[Container]
Image=registry.xphyrlab.net/velocor/velocor-velod:latest
ContainerName=velocor-velod
AutoUpdate=registry
Network=host
PidHost=true
SecurityLabelDisable=true
PodmanArgs=--privileged
Volume=/var/lib/velocor:/var/lib/velocor:rw
Volume=/run/velocor:/run/velocor:rw
Volume=/sys:/sys:rw
Volume=/dev:/dev:rslave
Exec=--listen :8443 --db /var/lib/velocor/velocor.db --spdk-socket /run/velocor/spdk.sock --hugepages-mb 512

[Service]
ExecStartPre=/usr/bin/mkdir -p /var/lib/velocor /run/velocor
Restart=always
RestartSec=3s

[Install]
WantedBy=multi-user.target default.target
