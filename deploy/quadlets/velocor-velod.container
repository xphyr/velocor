[Unit]
Description=Velocor Control-Plane Container (velod)
After=network-online.target
Wants=network-online.target

[Container]
# Filled in by the OS image build with the embedded image, pinned by digest.
Image=@VELOCOR_VELOD_IMAGE@
ContainerName=velocor-velod
# No AutoUpdate: an appliance changes only through `bootc upgrade`, which ships quadlets pinned
# to the image versions built from the same commit.
Network=host
SecurityLabelDisable=true
PodmanArgs=--privileged --pid=host
Volume=/var/lib/velocor:/var/lib/velocor:rw
# Built-in monitoring's config (velod writes it) and data.
Volume=/var/lib/velocor-monitoring:/var/lib/velocor-monitoring:rw
Volume=/run/velocor:/run/velocor:rw
Volume=/sys:/sys:rw
Volume=/dev:/dev:rslave
# A velod that stops answering (hung, deadlocked) is killed; systemd's Restart=always starts it
# again. /healthz only says velod serves requests, so a data-plane problem doesn't restart it.
HealthCmd=/usr/bin/velod healthcheck -listen :8443
HealthInterval=30s
HealthTimeout=10s
HealthRetries=3
HealthStartPeriod=2m
HealthOnFailure=kill
Exec=--listen :8443 --db /var/lib/velocor/velocor.db

[Service]
ExecStartPre=/usr/bin/mkdir -p /var/lib/velocor /run/velocor
Restart=always
RestartSec=3s

[Install]
WantedBy=multi-user.target default.target
