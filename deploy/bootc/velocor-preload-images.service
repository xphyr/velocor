[Unit]
Description=Preload embedded Velocor container images into Podman storage
DefaultDependencies=no
After=local-fs.target
Before=velocor-velod.service
ConditionPathExists=/usr/share/velocor/images

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/libexec/velocor-preload-images

[Install]
WantedBy=multi-user.target
