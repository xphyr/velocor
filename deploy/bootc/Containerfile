# Thin immutable appliance OS on Fedora image mode (bootc) 45.
# Runs spdk_tgt and velod as Podman quadlet containers.
#
# VELOD_IMAGE and SPDK_IMAGE are required and must be pinned by digest (repo@sha256:...);
# IMAGE_TAG is the tag they were pushed under, used only to name the embedded images.
# `make image-os` resolves them from the images pushed for the same commit. Both images
# are embedded in this OS image and the quadlets reference them by digest, so an appliance runs
# exactly the containers it was built and tested with, without a registry at boot, and only
# `bootc upgrade` changes them.
# The base follows Fedora's rolling fedora-bootc 45 image (daily fixes); `make image-os`
# resolves the tag to a digest per build and records it in the org.opencontainers.image.base.*
# labels.
ARG VELOD_IMAGE
ARG SPDK_IMAGE
ARG BOOTC_BASE_IMAGE=quay.io/fedora/fedora-bootc:45
# Built-in monitoring (TODO.md P1-1): embedded like spdk/velod, started only when turned on.
ARG PROMETHEUS_IMAGE=quay.io/prometheus/prometheus:v3.15.1@sha256:fa3302279710be2f21a8301ec17a8b4f2301fd829bd113839b3b6b02b6f191a2
ARG ALERTMANAGER_IMAGE=quay.io/prometheus/alertmanager:v0.34.2@sha256:39d8bb3966c694a124428a3a88fbcffd40bd069129ecd47c059f8a3f17c55f3b

# veloctl for the host comes from the same velod image the appliance runs.
FROM ${VELOD_IMAGE} AS velod-bin

FROM ${BOOTC_BASE_IMAGE}

ARG VELOD_IMAGE
ARG SPDK_IMAGE
ARG PROMETHEUS_IMAGE
ARG ALERTMANAGER_IMAGE
ARG IMAGE_TAG=pinned
# Only for CI builds of pull requests, whose images live in a throwaway local registry.
ARG INSECURE_REGISTRY=false

RUN dnf install -y \
      podman \
      skopeo \
      cloud-init \
      nvme-cli \
      iscsi-initiator-utils \
      pciutils \
      iproute \
      ethtool \
      xfsprogs \
      jq \
      open-vm-tools \
      qemu-guest-agent && \
    dnf clean all && \
    rm -rf /var/cache /var/log/dnf* /var/log/yum*

# Kernel modules for user-space PCIe NVMe polling (VFIO/UIO), NVMe-oF TCP, and ublk (Phase 2 NAS).
# No TCP autocorking: it held each NVMe/TCP read's small response until the NIC reported the
# data packet sent (lazily on virtio-net), adding ~1 ms to every small read (measured 2026-11-18).
RUN mkdir -p \
      /usr/lib/modules-load.d \
      /usr/lib/modprobe.d \
      /usr/lib/sysctl.d \
      /usr/lib/tmpfiles.d \
      /usr/share/containers/systemd && \
    printf "vfio\nvfio_iommu_type1\nvfio_pci\nuio_pci_generic\nnvme_tcp\nublk_drv\n" > /usr/lib/modules-load.d/velocor.conf && \
    printf "vm.nr_hugepages = 512\n" > /usr/lib/sysctl.d/90-velocor.conf && \
    printf "net.ipv4.tcp_autocorking = 0\n" >> /usr/lib/sysctl.d/90-velocor.conf && \
    printf "d /var/lib/velocor 0700 root root -\nd /run/velocor 0755 root root -\n" > /usr/lib/tmpfiles.d/velocor.conf && \
    printf "d /var/lib/velocor-monitoring 0755 root root -\nd /var/lib/velocor-monitoring/config 0750 root 65534 -\nd /var/lib/velocor-monitoring/prometheus 0750 65534 65534 -\nd /var/lib/velocor-monitoring/alertmanager 0750 65534 65534 -\n" > /usr/lib/tmpfiles.d/velocor-monitoring.conf

# Keep udev away from velod's short-lived metadata device (internal/meta)
COPY deploy/bootc/59-velocor-ublk.rules /usr/lib/udev/rules.d/59-velocor-ublk.rules

# Install operator CLI client on the host
COPY --from=velod-bin /usr/bin/veloctl /usr/bin/veloctl

# Install Podman Quadlet units for decoupled data-plane and control-plane containers
COPY deploy/quadlets/velocor-spdk.container /usr/share/containers/systemd/velocor-spdk.container
COPY deploy/quadlets/velocor-velod.container /usr/share/containers/systemd/velocor-velod.container
COPY deploy/quadlets/velocor-prometheus.container /usr/share/containers/systemd/velocor-prometheus.container
COPY deploy/quadlets/velocor-alertmanager.container /usr/share/containers/systemd/velocor-alertmanager.container

# Administrator account: velocor-admin, SSH keys only; root cannot log in over SSH.
# No keys or passwords are ever baked into this (public) image: they are added to a disk image
# by hack/build-qcow2.sh (/etc/ssh/authorized_keys.d/velocor-admin) or at boot by cloud-init.
COPY deploy/bootc/admin/velocor-admin.sysusers /usr/lib/sysusers.d/velocor-admin.conf
COPY deploy/bootc/admin/velocor-admin.tmpfiles /usr/lib/tmpfiles.d/velocor-admin.conf
COPY deploy/bootc/admin/velocor-admin.sudoers /etc/sudoers.d/velocor-admin
COPY deploy/bootc/admin/40-velocor.sshd.conf /etc/ssh/sshd_config.d/40-velocor.conf
COPY deploy/bootc/admin/10-velocor.cloud.cfg /etc/cloud/cloud.cfg.d/10-velocor.cfg
RUN chmod 0440 /etc/sudoers.d/velocor-admin && \
    chmod 0600 /etc/ssh/sshd_config.d/40-velocor.conf && \
    install -d -m 0755 /etc/ssh/authorized_keys.d && \
    visudo -cf /etc/sudoers.d/velocor-admin && \
    ssh-keygen -q -t ed25519 -N '' -f /tmp/check-hostkey && \
    sshd -t -f /etc/ssh/sshd_config -h /tmp/check-hostkey && \
    rm -f /tmp/check-hostkey /tmp/check-hostkey.pub

# ostree owns /boot (a bind mount of the root filesystem's /boot). On UEFI machines
# systemd-gpt-auto-generator would also put an automount for the EFI System Partition on /boot;
# it shadows ostree's mount and expires, so at shutdown ostree-finalize-staged cannot remount
# /boot read-write and every staged upgrade is silently dropped. Turn the generator off: by
# kernel argument (bootc applies kargs.d on install and upgrade) and by masking it, which also
# covers the first boot after upgrading from an image without the argument.
# SPDK drives NVMe through vfio-pci, which needs an IOMMU: Fedora kernels leave Intel's off by
# default (AMD's is on), so without intel_iommu=on velod can't claim any NVMe drive on Intel
# servers (found on the P0-1 lab VM). iommu=pt keeps devices the kernel still drives on
# passthrough mappings, as usual on SPDK/DPDK hosts.
RUN mkdir -p /usr/lib/bootc/kargs.d /etc/systemd/system-generators && \
    printf 'kargs = ["systemd.gpt_auto=0", "intel_iommu=on", "iommu=pt"]\n' > /usr/lib/bootc/kargs.d/10-velocor.toml && \
    ln -sf /dev/null /etc/systemd/system-generators/systemd-gpt-auto-generator

# Install ESXi-style appliance console splash banner (/etc/issue)
COPY deploy/bootc/velocor-console-banner.sh /usr/libexec/velocor-console-banner
COPY deploy/bootc/velocor-console.service /usr/lib/systemd/system/velocor-console.service
COPY deploy/bootc/90-velocor-banner /usr/lib/NetworkManager/dispatcher.d/90-velocor-banner

# Embed both container images (oci-archive keeps the registry manifest digest, so podman finds
# them by digest after loading) and pin the quadlets to exactly what was embedded.
COPY deploy/bootc/velocor-preload-images.sh /usr/libexec/velocor-preload-images
COPY deploy/bootc/velocor-preload-images.service /usr/lib/systemd/system/velocor-preload-images.service
# Registry credentials for private registries come in as a build secret (mounted for this step
# only, never written to a layer); `make image-os` passes REGISTRY_AUTH_FILE, or an empty one.
RUN --mount=type=secret,id=registry-auth set -eu; \
    tls=""; [ "${INSECURE_REGISTRY}" = "true" ] && tls="--src-tls-verify=false"; \
    auth=""; [ -s /run/secrets/registry-auth ] && auth="--authfile /run/secrets/registry-auth"; \
    mkdir -p /usr/share/velocor/images; \
    embed() { \
      ref="$1" name="$2"; \
      case "$ref" in */*@sha256:*) ;; *) echo "$name image '$ref' must be pinned by digest (repo@sha256:...)" >&2; exit 1 ;; esac; \
      repo="${ref%@*}" tag="${IMAGE_TAG}"; \
      case "${repo##*/}" in *:*) tag="${repo##*:}"; repo="${repo%:*}" ;; esac; \
      archive="/usr/share/velocor/images/$name.oci.tar"; \
      skopeo copy -q $tls $auth "docker://${repo}@${ref##*@}" "oci-archive:$archive:$repo:$tag"; \
      digest="$(skopeo inspect --format '{{.Digest}}' "oci-archive:$archive")"; \
      sed -i "s|^Image=.*|# Built from $repo:$tag\nImage=${repo}@${digest}|" "/usr/share/containers/systemd/$name.container"; \
      echo "$name: Image=${repo}@${digest} ($repo:$tag)"; \
    }; \
    embed "${SPDK_IMAGE}" velocor-spdk; \
    embed "${VELOD_IMAGE}" velocor-velod; \
    embed "${PROMETHEUS_IMAGE}" velocor-prometheus; \
    embed "${ALERTMANAGER_IMAGE}" velocor-alertmanager; \
    ! grep -q '@VELOCOR_' /usr/share/containers/systemd/velocor-*.container

RUN chmod 0755 /usr/libexec/velocor-console-banner /usr/libexec/velocor-preload-images /usr/lib/NetworkManager/dispatcher.d/90-velocor-banner && \
    systemctl disable bootc-fetch-apply-updates.timer && \
    systemctl enable velocor-console.service velocor-preload-images.service vmtoolsd.service qemu-guest-agent.service && \
    /usr/lib/systemd/system-generators/podman-system-generator --dryrun >/dev/null && \
    bootc container lint
